<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="inherit_production_order_form_views">
            <field name="name">inherit.production.order.stock.picking.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="po_sap_id" options="{'no_open': True, 'no_create': True}" readonly="1" domain="[('company_id', '=', company_id),('state', '=', ('open', 'in_progress'))]"/> <!--readonly="state in ('done', 'cancel')"-->
                </xpath>
            </field>
        </record>
    </data>
</odoo>