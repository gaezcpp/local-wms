<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="inherit_po_sap_stock_move_line_product_selector" model="ir.ui.view">
        <field name="name">inherit.stock.product.selector</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock_barcode.stock_move_line_product_selector"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="valid_wip_product_ids" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                <attribute name="domain">[
                    ('type', '=', 'consu'),
                    '|', 
                    ('company_id', '=', False), 
                    ('company_id', 'parent_of', company_id),
                    ('id', 'in', valid_wip_product_ids)
                ]</attribute>
                <!-- <attribute name="domain">[
                    ('type', '=', 'consu'),
                    '|', 
                    ('company_id', '=', False), 
                    ('company_id', 'parent_of', company_id),
                ]</attribute> -->
            </xpath>
        </field>
    </record>
</odoo>