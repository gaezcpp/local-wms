<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="production_order_sap_search">
        <field name="name">production.order.sap.search</field>
        <field name="model">production.order.sap</field>
        <field name="arch" type="xml">
            <search>
                <field name="po_number"/>
                <field name="order_type"/>
                <field name="product_id"/>
                <field name="company_id"/>
                <field name="state"/>
                <filter name="fl_open" string="Open" domain="[('state','=', 'open')]"/>
            </search>
        </field>
    </record>

    <record id="production_order_sap_view_list" model="ir.ui.view">
        <field name="name">production.order.sap.view.list</field>
        <field name="model">production.order.sap</field>
        <field name="arch" type="xml">
            <list string="Production Order SAP" create="0" edit="0" delete="0" duplicate="0">
                <field name="po_number"/>
                <field name="order_type"/>
                <field name="start_date"/>
                <field name="finish_date"/>
                <field name="product_id"/>
                <field name="order_qty"/>
                <field name="company_id" optional="show"/>
                <field name="sap_pp" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'closed'" decoration-warning="state == 'open'"/>
            </list>
        </field>
    </record>

    <record id="production_order_sap_view_form" model="ir.ui.view">
        <field name="name">production.order.sap.view.form</field>
        <field name="model">production.order.sap</field>
        <field name="arch" type="xml">
            <form string="Production Order SAP" create="0" edit="0" delete="0" duplicate="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <!-- <div class="oe_button_box" name="button_box">
                        <button name="action_smart_button_debt_line" type="object" class="oe_stat_button" icon="fa-tint">
                            <field name="debt_line_count" string="Debts" widget="statinfo"/>
                        </button>
                    </div> -->
					<label for="po_number" class="oe_edit_only"/>
                    <h1>
                        <field name="po_number" force_save="1" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="order_type"/>
                            <field name="status_teco"/>
                            <field name="start_date"/>
                            <field name="finish_date"/>
                            <field name="created_user"/>
                        </group>
                        <group>
                            <field name="product_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="uom_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="order_qty"/>
                            <field name="company_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="company_registry"/>
                            <field name="sap_pp" force_save="1" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="production_order_sap_action" model="ir.actions.act_window">
        <field name="name">Production Order SAP</field>
        <field name="res_model">production.order.sap</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>