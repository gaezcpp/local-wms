<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="production_order_sap_search">
        <field name="name">production.order.sap.search</field>
        <field name="model">production.order.sap</field>
        <field name="arch" type="xml">
            <search>
                <field name="po_number"/>
                <field name="order_type"/>
                <field name="product_id"/>
                <field name="company_id"/>
                <field name="state"/>
                <filter name="fl_open" string="Open" domain="[('state','=', 'open')]"/>
                <filter name="fl_ip" string="In Progress" domain="[('state','=', 'in_progress')]"/>
                <filter name="fl_teco" string="Teco" domain="[('state','=', 'teco')]"/>
                <filter name="fl_not_teco" string="NOT TECO" domain="[('state','!=', 'teco')]"/>
                <filter name="fl_archived" string="Archived" domain="[('active','=', False)]"/>
                <group>
                    <filter name="gr_state" string="By State" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="production_order_sap_view_kanban" model="ir.ui.view">
        <field name="name">production.order.sap.kanban</field>
        <field name="model">production.order.sap</field>
        <field name="arch" type="xml">
            <kanban records_draggable="0" class="o_kanban_mobile" create="0" edit="0" delete="0" quick_create="0" quick_edit="0">
                <field name="po_number"/>
                <field name="product_id"/>
                <field name="state"/>
                <field name="order_qty"/>
                <field name="finish_date"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="row mb-2">
                                <div class="col-8">
                                    <strong><field name="po_number"/></strong>
                                </div>
                                <div class="col-4 text-right">
                                    <field name="state" widget="badge" decoration-success="state == 'closed'" decoration-warning="state == 'open'"/>
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-12 text-muted">
                                    <field name="product_id"/>
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-12 text-muted">
                                    Order Type: <field name="order_type"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    Qty: <strong><field name="order_qty"/></strong>
                                </div>
                                <div class="col-6 text-right text-muted">
                                    <field name="finish_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="production_order_sap_view_list" model="ir.ui.view">
        <field name="name">production.order.sap.view.list</field>
        <field name="model">production.order.sap</field>
        <field name="arch" type="xml">
            <list string="Production Order SAP" create="0" edit="0" delete="0" duplicate="0">
                <field name="po_number"/>
                <field name="order_type" optional="hide"/>
                <field name="start_date" optional="hide"/>
                <field name="finish_date" optional="hide"/>
                <field name="product_id"/>
                <field name="order_qty"/>
                <field name="company_id" optional="hide"/>
                <field name="sap_pp" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="production_order_sap_view_form" model="ir.ui.view">
        <field name="name">production.order.sap.view.form</field>
        <field name="model">production.order.sap</field>
        <field name="arch" type="xml">
            <form string="Production Order SAP" create="0" edit="0" delete="0" duplicate="0">
                <header>
                    <button name="action_picking_po_sap" string="GR FG" type="object" class="oe_highlight" invisible="state == 'teco'"/>
                    <button name="action_open_qr_po_sap_wizard" string="Generate QR" type="object" class="btn-secondary" invisible="state == 'teco'"/>
                    <button name="action_picking_wip_po" string="GR WIP" type="object" invisible="1"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,in_progress,teco"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_smart_picking_po_sap" type="object" class="oe_stat_button" icon="fa-truck" invisible="picking_count == 0">
                            <field name="picking_count" string="Picking" widget="statinfo"/>
                        </button>
                        <button name="action_smart_po_sap_move_history" class="oe_stat_button" icon="fa-bars" type="object">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">Good Moves</span>
                            </div>
                        </button>
                    </div>
					<label for="po_number" class="oe_edit_only"/>
                    <h1>
                        <field name="po_number" force_save="1" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="order_type"/>
                            <field name="status_teco"/>
                            <field name="start_date"/>
                            <field name="finish_date"/>
                            <field name="created_user"/>
                        </group>
                        <group>
                            <field name="product_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="uom_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="order_qty"/>
                            <field name="gr_bag_qty" string="GR Pack"/>
                            <field name="gr_kg_qty" string="GR Qty"/>
                            <field name="remaining_qty"/>
                            <field name="company_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="company_registry"/>
                            <field name="sap_pp" force_save="1" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
						<page string="Component">
							<field name="po_sap_line_ids">
								<list editable="bottom">
                                    <field name="po_sap_id" column_invisible="1" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="no_item" readonly="1"/>
                                    <field name="product_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="uom_id" readonly="1" widget="many2one_uom" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="order_qty" readonly="1"/>
                                    <field name="warehouse_id" readonly="1"/>
								</list>
								<form create="0" edit="0" delete="0">
                                    <group>
                                        <field name="po_sap_id" invisible="1" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                                        <field name="no_item" readonly="1"/>
                                        <field name="product_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                                        <field name="uom_id" readonly="1" widget="many2one_uom" options="{'no_open': True, 'no_create': True}"/>
                                        <field name="order_qty" readonly="1"/>
                                        <field name="warehouse_id" readonly="1"/>
                                    </group>
								</form>
							</field>
						</page>
					</notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="production_order_sap_action" model="ir.actions.act_window">
        <field name="name">Production Order SAP</field>
        <field name="res_model">production.order.sap</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_fl_not_teco': 1}</field>
    </record>

    <record id="qr_production_order_sap_client" model="ir.actions.client">
        <field name="name">QR Production Order SAP</field>
        <field name="tag">qr_scanner_action</field>
    </record>

    <record id="qr_gr_fg_scanner_client" model="ir.actions.client">
        <field name="name">QR Scanner GR FG</field>
        <field name="tag">qr_scanner_gr_fg_action</field>
    </record>
</odoo>