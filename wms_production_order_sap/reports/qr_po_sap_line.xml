<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paperformat: Ukuran di Odoo menggunakan milimeter (mm). 3cm = 30mm, 4cm = 40mm -->
    <record id="paperformat_pallet" model="report.paperformat">
        <field name="name">Format Pallet 3x4 cm</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">30</field>
        <field name="page_height">40</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">300</field>
    </record>

    <template id="qr_po_sap_line" name="qr_po_sap_line">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page" style="margin: 0 auto; padding: 2px; width: 100%; height: 100%; box-sizing: border-box;">
                        <center>
                            <!-- 1. Ubah width menjadi 100% agar responsif terhadap batas kertas 3x4 cm -->
                            <table class="table-borderless" style="width: 100%; margin: 0 auto; padding: 0; border-collapse: collapse; border: none; table-layout: fixed;">
                                <tr>
                                    <td style="border: none; padding: 0;">
                                        <!-- 2. Gambar mengisi lebar sel; sel ini yang jadi acuan lebar semua teks di bawahnya -->
                                        <img t-if="doc.po_sap_id.po_number and doc.production_line_id.code"
                                            t-att-src="'data:image/png;base64,%s' % doc._get_qr_image_base64()"
                                            alt="QR Code" style="width: 100%; max-width: 100%; height: auto; object-fit: contain; margin: 0 auto; display: block;"/>
                                    </td>
                                </tr>
                                <tr>
                                    <!-- 3. Teks rata tengah, dibatasi lebar sel (= lebar gambar) -->
                                    <td style="font-size: 28px; font-weight: bold; line-height: 1; padding-top: 4px; border: none; word-wrap: break-word; overflow-wrap: break-word; text-align: center;">
                                        <t t-esc="doc.po_sap_id.po_number"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="font-size: 28px; line-height: 1; padding-top: 1px; border: none; word-wrap: break-word; overflow-wrap: break-word; text-align: center;">
                                        <t t-esc="doc.po_sap_id.order_type"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="font-size: 28px; font-weight: bold; line-height: 1; padding-top: 1px; border: none; word-wrap: break-word; overflow-wrap: break-word; text-align: center;">
                                        <t t-esc="doc.production_line_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="font-size: 28px; line-height: 1; padding-top: 1px; border: none; word-wrap: break-word; overflow-wrap: break-word; text-align: center;">
                                        <t t-esc="doc.po_sap_id.product_id.default_code"/>
                                    </td>
                                </tr>
                            </table>
                        </center>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_qr_po_sap_line" model="ir.actions.report">
        <field name="name">Print QR PO SAP Line</field>
        <field name="model">qr.po.sap</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">wms_production_order_sap.qr_po_sap_line</field>
        <field name="report_file">wms_production_order_sap.qr_po_sap_line</field>
        <field name="print_report_name">'QR-Label-%s-%s' % (object.po_sap_id.po_number, object.production_line_id.code)</field>
        <!-- <field name="paperformat_id" ref="paperformat_pallet"/> -->
    </record>
</odoo>