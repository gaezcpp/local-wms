        <record id="query_production_order_sap" model="ir.config_parameter">
            <field name="key">query_production_order_sap</field>
            <field name="value">SELECT a.aufnr, a.auart, p.matnr, a.werks, k.gamng, p.meins, k.gmein, k.gstrp, k.gltrp, a.ernam, a.erdat, marm.umrez, marm.umren, 'NOT TECO' AS teco_status, a.loekz, s.matnr as component, s.BDMNG, s.MEINS as uom_comp, s.rspos FROM aufk a LEFT JOIN afko k ON a.aufnr = k.aufnr AND a.mandt = k.mandt LEFT JOIN afpo p ON a.aufnr = p.aufnr AND a.mandt = p.mandt LEFT JOIN marm ON marm.matnr = p.matnr AND marm.meinh = k.gmein AND marm.mandt = p.mandt JOIN resb s ON a.aufnr = s.aufnr AND a.mandt = s.mandt WHERE a.autyp = '10' AND TO_DATE(a.erdat,'YYYYMMDD') BETWEEN SYSDATE-100 AND SYSDATE AND NOT EXISTS (SELECT 1 FROM jest j WHERE j.objnr = a.objnr AND j.stat = 'I0045' AND j.inact = ' ' AND a.mandt = j.mandt)</field>
        </record>
        <record id="operation_type_barcode_wip" model="ir.config_parameter">
            <field name="key">operation_type_barcode_wip</field>
            <field name="value">888</field>
        </record>
        <record id="operation_type_barcode_fg" model="ir.config_parameter">
            <field name="key">operation_type_barcode_fg</field>
            <field name="value">888</field>
        </record>
        <record id="production_order_tolerance_sap" model="ir.config_parameter">
