<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="debt_type_search">
        <field name="name">debt.type.search</field>
        <field name="model">debt.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="debt_type_view_list" model="ir.ui.view">
        <field name="name">debt.type.view.list</field>
        <field name="model">debt.type</field>
        <field name="arch" type="xml">
            <list string="Debt Type">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="debt_type_view_form" model="ir.ui.view">
        <field name="name">debt.type.view.form</field>
        <field name="model">debt.type</field>
        <field name="arch" type="xml">
            <form string="Debt Type">
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="debt_type_action" model="ir.actions.act_window">
        <field name="name">Debt Type</field>
        <field name="res_model">debt.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>