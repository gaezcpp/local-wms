<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="debt_management_search">
        <field name="name">debt.management.search</field>
        <field name="model">debt.management</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="state"/>
            </search>
        </field>
    </record>

    <record id="debt_management_view_list" model="ir.ui.view">
        <field name="name">debt.management.view.list</field>
        <field name="model">debt.management</field>
        <field name="arch" type="xml">
            <list string="Debt Management">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="state"/>
                <field name="total_amount" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="debt_management_view_form" model="ir.ui.view">
        <field name="name">debt.management.view.form</field>
        <field name="model">debt.management</field>
        <field name="arch" type="xml">
            <form string="Debt Management">
                <header>
                    <!-- <button name="action_open_wizard_pay" string="Pay" type="object" class="oe_highlight"/> -->
                    <button name="action_in_progress" string="Set In Progress" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set Draft" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_paid" string="Set Paid" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_print_pdf" string="Print" type="object" class="oe_highlight" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_smart_button_debt_line" type="object" class="oe_stat_button" icon="fa-tint">
                            <field name="debt_line_count" string="Debts" widget="statinfo"/>
                        </button>
                    </div>
					<label for="name" class="oe_edit_only"/>
                    <h1>
                        <field name="name" force_save="1" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="customer_id" required="1" readonly="state != 'draft'" options="{'no_open': True, 'no_create': True}"/>
                            <label for="amount" invisible="state != 'in_progress'"/>
                            <div class="o_row" invisible="state != 'in_progress'">
                                <field name="amount" readonly="state != 'in_progress'" string="Auto Reconcile"/>
                                <button name="action_distribute_payment" string="PAY" type="object" class="btn btn-success" invisible="state != 'in_progress'" confirm="Make sure the amount is correct!"/>
                            </div>
                            <field name="paid_amount" force_save="1" readonly="1"/>
                            <field name="total_amount" force_save="1" readonly="1"/>
                            <field name="over_paid_amount" force_save="1" readonly="1" invisible="state != 'paid'"/>
                        </group>
                    </group>
                    <notebook>
						<page string="Debts">
							<field name="debt_line_ids" readonly="state == 'paid'">
								<list editable="bottom" default_order="end_date asc">
									<field name="debt_type_id" options="{'no_open': True, 'no_create': True}" readonly="parent.state != 'draft' or state != 'in_progress'"/>
                                    <field name="start_date" optional="hide" force_save="1" readonly="1"/>
									<field name="end_date" required="1" readonly="parent.state != 'draft' or state != 'in_progress'"/>
									<field name="due_days" force_save="1" readonly="1"/>
									<field name="amount" readonly="parent.state != 'draft' or state != 'in_progress'" sum="Total"/>
                                    <field name="partially_paid" optional="hide" readonly="parent.state == 'paid' or state != 'in_progress'"/>
                                    <field name="paid_amount" readonly="parent.state != 'in_progress'" sum="partial_total"/>
                                    <field name="amount_total" string="Remaining" force_save="1" readonly="1" sum="all_total"/>
									<field name="state" optional="hide" force_save="1" readonly="1"/>
                                    <field name="notes" optional="show" readonly="parent.state == 'paid' or state != 'in_progress'"/>
                                    <!-- <button name="action_paid" string="Paid" type="object" class="oe_highlight" confirm="Confirm?" invisible="state != 'in_progress'"/> -->
								</list>
								<form create="0" edit="0" delete="0">
                                    <group>
                                        <field name="debt_type_id" options="{'no_open': True, 'no_create': True}" readonly="1"/>
                                        <field name="end_date" readonly="1"/>
                                        <field name="due_days" readonly="1"/>
                                        <field name="amount" readonly="1"/>
                                        <field name="partially_paid" readonly="1"/>
                                        <field name="partially_paid" readonly="1"/>
                                        <field name="paid_amount" readonly="1"/>
                                        <field name="amount_total" readonly="1"/>
                                        <field name="state" readonly="1"/>
                                    </group>
								</form>
							</field>
						</page>
					</notebook>
                    <separator string="Descriptions"/>
                    <label for="notes" string="Notes"/>
                    <div style="margin-bottom: 12px; max-height: 180px; overflow-y: auto;">
                        <field name="notes" readonly="state == 'paid'" placeholder="Enter your description . . ."/>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="debt_management_action" model="ir.actions.act_window">
        <field name="name">Debt Management</field>
        <field name="res_model">debt.management</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>