<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="sap_aft_search">
        <field name="name">sap.aft.search</field>
        <field name="model">sap.aft</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="stock_type_from"/>
                <field name="stock_type_to"/>
                <field name="move_type"/>
            </search>
        </field>
    </record>

    <record id="sap_aft_view_list" model="ir.ui.view">
        <field name="name">sap.aft.view.list</field>
        <field name="model">sap.aft</field>
        <field name="arch" type="xml">
            <list string="SAP AFT">
                <field name="name"/>
                <field name="stock_type_from"/>
                <field name="stock_type_to"/>
                <field name="move_type"/>
            </list>
        </field>
    </record>

    <record id="sap_aft_view_form" model="ir.ui.view">
        <field name="name">sap.aft.view.form</field>
        <field name="model">sap.aft</field>
        <field name="arch" type="xml">
            <form string="SAP AFT">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="stock_type_from"/>
                        <field name="stock_type_to"/>
                        <field name="move_type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sap_aft_action" model="ir.actions.act_window">
        <field name="name">SAP AFT</field>
        <field name="res_model">sap.aft</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>