<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="quality_packages_search_views">
        <field name="name">quality.packages.search</field>
        <field name="model">quality.packages</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="picking_id"/>
                <field name="packages_ids"/>
                <field name="state"/>
                <group>
                    <filter name="gr_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="gr_picking" string="Picking" context="{'group_by':'picking_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="quality_packages_view_list" model="ir.ui.view">
        <field name="name">quality.packages.view.list</field>
        <field name="model">quality.packages</field>
        <field name="arch" type="xml">
            <list string="Quality Packages">
                <field name="name"/>
                <field name="picking_id"/>
                <field name="packages_ids"/>
                <field name="state"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="quality_packages_view_form" model="ir.ui.view">
        <field name="name">quality.packages.view.form</field>
        <field name="model">quality.packages</field>
        <field name="arch" type="xml">
            <form string="Quality Packages">
                <header>
					<button name="action_in_progress" string="Confirm" type="object" confirm="Yakin?" class="oe_highlight" invisible="state != 'draft'"/>
					<button name="action_open_wizard_packages" string="Check Packages" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
					<button name="action_failed" string="Failed" type="object" confirm="Yakin?" class="btn btn-danger" invisible="state != 'in_progress'"/>
					<button name="action_draft" string="Draft" type="object" confirm="Yakin?" class="btn btn-danger" invisible="1"/> <!--invisible="state in ['draft', 'completed', 'failed']"-->
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <label for="name" class="oe_edit_only"/>
                    <h1>
                        <field name="name" force_save="1" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="picking_id" options="{'no_open': True, 'no_create': True}" readonly="state != 'draft'" domain="[('picking_type_code', '=', 'incoming')]"/>
                            <field name="company_id" force_save="1" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="e.g Packages sedang rusak" readonly="state != 'draft'" required="1"/>
                    </group>
                    <notebook>
                        <page name="packages" string="Packages">
                            <field name="packages_ids" force_save="1" readonly="1">
								<list create="0" delete="0" edit="0">
                                    <field name="name"/>
                                    <field name="parent_package_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="package_type_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="location_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="pallet_status"/>
                                    <field name="pack_date"/>
                                    <field name="state"/>
								</list>
								<form create="0" edit="0" delete="0">
                                    <group>
                                        <field name="name" readonly="1"/>
                                        <field name="pallet_status"/>
                                        <field name="state" readonly="1"/>
                                        <field name="location_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                                    </group>
								</form>
							</field>
						</page>
					</notebook>
                    <!-- <separator string="Notes"/> -->
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <record id="quality_packages_action" model="ir.actions.act_window">
        <field name="name">Quality Packages</field>
        <field name="res_model">quality.packages</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>