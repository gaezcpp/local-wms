<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="quality_packages_search_views">
        <field name="name">quality.packages.search</field>
        <field name="model">quality.packages</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="picking_id"/>
                <field name="packages_ids"/>
                <field name="state"/>
                <group>
                    <filter name="gr_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="gr_picking" string="Picking" context="{'group_by':'picking_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="quality_packages_view_list" model="ir.ui.view">
        <field name="name">quality.packages.view.list</field>
        <field name="model">quality.packages</field>
        <field name="arch" type="xml">
            <list string="Quality Packages">
                <field name="name"/>
                <field name="picking_id"/>
                <field name="packages_ids"/>
                <field name="state"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="quality_packages_view_form" model="ir.ui.view">
        <field name="name">quality.packages.view.form</field>
        <field name="model">quality.packages</field>
        <field name="arch" type="xml">
            <form string="Quality Packages">
                <header>
					<button name="action_completed" string="Completed" type="object" confirm="Yakin?" class="btn btn-success" invisible="state != 'draft'"/>
					<button name="action_failed" string="Failed" type="object" confirm="Yakin?" class="btn btn-danger" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <label for="name" class="oe_edit_only"/>
                    <h1>
                        <field name="name" force_save="1" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="picking_id" options="{'no_open': True, 'no_create': True}" readonly="state != 'draft'"/>
                            <!-- <field name="packages_ids" options="{'no_open': True, 'no_create': True}" widget="many2many_tags" readonly="state != 'draft'"/> -->
                            <field name="company_id" force_save="1" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Packages">
                            <field name="package_ids" readonly="state != 'draft'">
								<!-- <list editable="bottom" create="0" delete="0">
									<field name="name" readonly="1"/>
									<field name="pl"/>
									<field name="cv"/>
									<field name="panjang"/>
									<field name="jumlah_benur"/>
									<field name="jumlah_kompetitor_benur"/>
									<field name="strain"/>
									<field name="kode_bak"/>
									<field name="tanggal_tebar"/>
									<field name="tanggal_do"/>
								</list>
								<form create="0" edit="0" delete="0">
									<field name="name" readonly="1"/>
								</form> -->
							</field>
						</page>
						<page string="Notes">
							<field name="notes" placeholder="e.g Packages sedang rusak" readonly="state != 'draft'"/>
						</page>
					</notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <record id="quality_packages_action" model="ir.actions.act_window">
        <field name="name">Quality Packages</field>
        <field name="res_model">quality.packages</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>