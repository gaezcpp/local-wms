<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="package_wizards_form_views" model="ir.ui.view">
        <field name="name">package.wizards.form.views</field>
        <field name="model">package.wizards</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="quality_package_id" required="1" force_save="1" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                        <field name="partial_update"/>
                        <field name="state" invisible="partial_update"/>
                    </group>
                </group>
                <field name="package_wizards_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="package_id" options="{'no_open': True, 'no_create': True}" readonly="1"/>
                        <field name="parent_package_id" options="{'no_open': True, 'no_create': True}" readonly="1"/>
                        <field name="package_type_id" options="{'no_open': True, 'no_create': True}" readonly="1"/>
                        <field name="location_id" options="{'no_open': True, 'no_create': True}" readonly="1"/>
                        <field name="pallet_status" readonly="1"/>
                        <field name="pack_date" readonly="1"/>
                        <field name="state" readonly="1"/>
                        <field name="state_after" column_invisible="not parent.partial_update"/>
                    </list>
                    <form create="0" delete="0" edit="0">
                        <group>
                            <field name="package_id" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                    </form>
                </field>
                <footer>
                    <button name="action_update_state" string="Confirm" confirm="Pastikan data sudah sesuai!" type="object" default_focus="1" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
