<odoo>
    <data noupdate="1">
        <record id="rule_user_picking_type" model="ir.rule">
            <field name="name">User Operation Types Restriction</field>
            <field name="model_id" ref="stock.model_stock_picking_type"/>
            <field name="domain_force">[('id', 'in', user.picking_type_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <record id="rule_admin_picking_type" model="ir.rule">
            <field name="name">Admin Operation Types All</field>
            <field name="model_id" ref="stock.model_stock_picking_type"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
        </record>

        <record id="rule_user_stock_picking" model="ir.rule">
            <field name="name">User Stock Picking Restriction</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">['|', ('picking_type_id', '=', False), ('picking_type_id', 'in', user.picking_type_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <record id="rule_admin_stock_picking" model="ir.rule">
            <field name="name">Admin Stock Picking All</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
        </record>
    </data>
</odoo>