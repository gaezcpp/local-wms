<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="inherit_stock_package_form_views">
            <field name="name">inherit.stock.package.form</field>
            <field name="model">stock.package</field>
            <field name="inherit_id" ref="stock.stock_package_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='unpack']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='unpack']" position="after">
                    <button name="action_ready" string="Set Ready" type="object" class="oe_highlight" invisible="yellow_tag == 'ready'"/>
                    <button name="action_hold" string="Set Hold" type="object" class="btn-danger" invisible="yellow_tag == 'hold'"/>
                    <field name="yellow_tag" force_save="1" readonly="1" widget="statusbar"/>
                </xpath>
                <xpath expr="//field[@name='contained_quant_ids']/list/field[@name='lot_id']" position="after">
                    <field name="stock_type"/>
                </xpath>
                <xpath expr="//sheet" position="after">
                    <chatter reload_on_follower="True"/>
                </xpath>
                <!--PEMBATASAN USER-->
                <xpath expr="//form" position="attributes">
                    <attribute name="create">0</attribute>
                    <attribute name="edit">0</attribute>
                    <attribute name="delete">0</attribute>
                </xpath>
                <xpath expr="//field[@name='package_type_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                    <attribute name="force_save">1</attribute>
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='location_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                    <attribute name="force_save">1</attribute>
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='parent_package_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                    <attribute name="force_save">1</attribute>
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='company_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                    <attribute name="force_save">1</attribute>
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='pack_date']" position="attributes">
                    <attribute name="force_save">1</attribute>
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='contained_quant_ids']/list" position="attributes">
                    <attribute name="create">0</attribute>
                    <attribute name="edit">0</attribute>
                    <attribute name="delete">0</attribute>
                </xpath>
                <xpath expr="//field[@name='contained_quant_ids']/list/field[@name='product_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='contained_quant_ids']/list/field[@name='package_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='contained_quant_ids']/list/field[@name='lot_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='contained_quant_ids']/list/field[@name='product_uom_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='contained_quant_ids']/kanban/templates/t/field[@name='product_id']" position="after">
                    <span>Stock Type : <field name="stock_type" force_save="1" readonly="1"/></span>
                </xpath>
                <xpath expr="//field[@name='contained_quant_ids']/kanban/templates/t/field[@name='product_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='contained_quant_ids']/kanban/templates/t/field[@name='lot_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='contained_quant_ids']/kanban/templates/t/div/field[@name='product_uom_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
            </field>
        </record>

