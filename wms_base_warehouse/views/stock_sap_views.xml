<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="stock_sap_search">
        <field name="name">stock.sap.search</field>
        <field name="model">stock.sap</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="company_id"/>
            </search>
        </field>
    </record>

    <record id="stock_sap_view_list" model="ir.ui.view">
        <field name="name">stock.sap.view.list</field>
        <field name="model">stock.sap</field>
        <field name="arch" type="xml">
            <list string="Stock SAP">
                <field name="product_id"/>
                <field name="product_uom_id"/>
                <field name="location_id"/>
                <field name="company_id"/>
                <field name="odoo_stock"/>
                <field name="unrestricted_stock"/>
                <field name="quality_inspection_stock"/>
                <field name="blocked_stock"/>
            </list>
        </field>
    </record>

    <record id="stock_sap_view_form" model="ir.ui.view">
        <field name="name">stock.sap.view.form</field>
        <field name="model">stock.sap</field>
        <field name="arch" type="xml">
            <form string="Stock SAP">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="product_uom_id"/>
                            <field name="location_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="odoo_stock"/>
                            <field name="unrestricted_stock"/>
                            <field name="quality_inspection_stock"/>
                            <field name="blocked_stock"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_sap_action" model="ir.actions.act_window">
        <field name="name">SAP Stock</field>
        <field name="res_model">stock.sap</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>