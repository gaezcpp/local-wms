<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="stock_warehouse_category_search">
        <field name="name">stock.warehouse.category.search</field>
        <field name="model">stock.warehouse.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="stock_warehouse_category_view_list" model="ir.ui.view">
        <field name="name">stock.warehouse.category.view.list</field>
        <field name="model">stock.warehouse.category</field>
        <field name="arch" type="xml">
            <list string="">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="stock_warehouse_category_view_form" model="ir.ui.view">
        <field name="name">stock.warehouse.category.view.form</field>
        <field name="model">stock.warehouse.category</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_warehouse_category_action" model="ir.actions.act_window">
        <field name="name">Quality Category</field>
        <field name="res_model">stock.warehouse.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>