<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="inherit_stock_picking_type_form_views">
            <field name="name">inherit.stock.picking.type.form</field>
            <field name="model">stock.picking.type</field>
            <field name="inherit_id" ref="stock.view_picking_type_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='barcode']" position="after">
                    <field name="move_type_sap"/>
                </xpath>
                <xpath expr="//group[@name='second']" position="after">
                    <group>
                        <group name="custom_1" string="Custom1">
                            <field name="uu_only"/>
                            <field name="production_only"/>
                            <field name="checker_only"/>
                            <field name="quality_type_id" required="checker_only" invisible="not checker_only"/>
                            <field name="quantity_type_id" required="checker_only" invisible="not checker_only"/>
                            <field name="checker_out"/>
                            <field name="quality_out_type_id" required="checker_out" invisible="not checker_out"/>
                            <field name="quantity_out_type_id" required="checker_out" invisible="not checker_out"/>
                            <field name="book_full_pallet"/>
                            <field name="mandatory_destination"/>
                            <field name="split_package"/>
                        </group>
                        <group name="custom2" string="Custom2">
                            <field name="bypass_entire_packs"/>
                            <field name="create_new_picking"/>
                            <field name="autofill_pack_qty"/>
                            <field name="restrict_over_demand"/>
                            <field name="hide_zero_qty"/>
                            <field name="hide_edit_barcode"/>
                            <field name="check_scan_pallet"/>
                            <field name="bulk_pallet_lot"/>
                            <field name="check_order_selection"/>
                        </group>
                    </group>
                </xpath>
                <xpath expr="//field[@name='return_picking_type_id']" position="after">
                    <field name="packaging_type_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>