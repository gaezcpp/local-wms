<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="inherit_product_template_form">
            <field name="name">inherit.product.template.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='inventory']" position="after">
                    <page name="wip" string="Family SKU">
                        <field name="product_wip_line_ids">
                            <list editable="bottom">
                                <field name="product_id" options="{'no_create': True}"/>
                                <field name="default_code" force_save="1" readonly="1" optional="hide"/>
                                <field name="warehouse_id" options="{'no_create': True}" required="1"/>
                            </list>
                            <form create="0" edit="0" delete="0">
                                <group>
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="default_code" force_save="1" readonly="1"/>
                                    <field name="warehouse_id" options="{'no_create': True}"/>
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>