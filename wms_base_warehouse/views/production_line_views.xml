<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="production_line_search">
        <field name="name">production.line.search</field>
        <field name="model">production.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="prod_code"/>
                <field name="company_id"/>
            </search>
        </field>
    </record>

    <record id="production_line_view_tree" model="ir.ui.view">
        <field name="name">production.line.view.tree</field>
        <field name="model">production.line</field>
        <field name="arch" type="xml">
            <list string="Production Line">
                <field name="code"/>
                <field name="name"/>
                <field name="prod_code"/>
                <field name="sap_sync"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="production_line_view_form" model="ir.ui.view">
        <field name="name">production.line.view.form</field>
        <field name="model">production.line</field>
        <field name="arch" type="xml">
            <form string="Production Line">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                <field name="prod_code"/>
                        <field name="sap_sync" force_save="1" readonly="1"/>
                        <field name="company_id" options="{'no_open': True, 'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="production_line_action" model="ir.actions.act_window">
        <field name="name">Production Line</field>
        <field name="res_model">production.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
