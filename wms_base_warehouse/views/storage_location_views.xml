<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="storage_location_search">
        <field name="name">storage.location.search</field>
        <field name="model">storage.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
            </search>
        </field>
    </record>

    <record id="storage_location_view_list" model="ir.ui.view">
        <field name="name">storage.location.view.list</field>
        <field name="model">storage.location</field>
        <field name="arch" type="xml">
            <list string="Storage Location" create="0" edit="0" delete="0" duplicate="0">
                <field name="name"/>
                <field name="code"/>
                <field name="sap_sync"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="storage_location_view_form" model="ir.ui.view">
        <field name="name">storage.location.view.form</field>
        <field name="model">storage.location</field>
        <field name="arch" type="xml">
            <form string="Storage Location" create="0" edit="0" delete="0" duplicate="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sap_sync"/>
                        <field name="company_id" options="{'no_open': True, 'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="storage_location_action" model="ir.actions.act_window">
        <field name="name">Storage Location</field>
        <field name="res_model">storage.location</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>