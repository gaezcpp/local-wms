<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="product_packaging_sap_search">
        <field name="name">product.packaging.sap.search</field>
        <field name="model">product.packaging.sap</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="packaging_code"/>
                <field name="packaging_desc"/>
                <field name="company_id"/>
            </search>
        </field>
    </record>

    <record id="product_packaging_sap_view_list" model="ir.ui.view">
        <field name="name">product.packaging.sap.view.list</field>
        <field name="model">product.packaging.sap</field>
        <field name="arch" type="xml">
            <list string="Product Packaging SAP" create="0" edit="0" delete="0" duplicate="0">
                <field name="product_id"/>
                <field name="product_uom_desc"/>
                <field name="packaging_code"/>
                <field name="packaging_desc"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="product_packaging_sap_view_form" model="ir.ui.view">
        <field name="name">product.packaging.sap.view.form</field>
        <field name="model">product.packaging.sap</field>
        <field name="arch" type="xml">
            <form string="Product Packaging SAP" create="0" edit="0" delete="0" duplicate="0">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="product_uom_desc"/>
                            <field name="packaging_code"/>
                            <field name="packaging_desc"/>
                            <field name="company_id" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="product_packaging_sap_action" model="ir.actions.act_window">
        <field name="name">Product Packaging SAP</field>
        <field name="res_model">product.packaging.sap</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>