<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="production_group_search">
        <field name="name">production.group.search</field>
        <field name="model">production.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <record id="production_group_view_list" model="ir.ui.view">
        <field name="name">production.group.view.list</field>
        <field name="model">production.group</field>
        <field name="arch" type="xml">
            <list string="Production Group">
                <field name="name"/>
                <field name="code"/>
                <field name="user_id"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="production_group_view_form" model="ir.ui.view">
        <field name="name">production.group.view.form</field>
        <field name="model">production.group</field>
        <field name="arch" type="xml">
            <form string="Production Group">
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                        <field name="code" required="1"/>
                        <field name="user_id" options="{'no_open': True, 'no_create': True}" required="1"/>
                        <field name="company_id" options="{'no_open': True, 'no_create': True}" required="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="production_group_action" model="ir.actions.act_window">
        <field name="name">Production Group</field>
        <field name="res_model">production.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>