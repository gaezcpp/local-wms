<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="inherit_base_stock_picking_form">
            <field name="name">base.inherit.stock.picking.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="over_delivery" force_save="1" readonly="1" string="Qty Difference"/>
                </xpath>
                <xpath expr="//field[@name='use_create_lots']" position="after">
                    <field name="production_shift_id" options="{'no_open': True, 'no_create': True}" readonly="state in ('done', 'cancel')"/>
                    <field name="synchronize_sap" readonly="1"/>
                    <field name="production_only" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='move_ids']/list/field[@name='product_id']" position="before">
                    <field name="sap_seq" readonly="1"/>
                </xpath>
                <xpath expr="//page[@name='extra']" position="before">
                    <page name="product_packaging_sap" string="Packaging Details" invisible="not production_only">
                        <field name="product_packaging_ids">
                            <list create="0" delete="0" edit="0">
                                <field name="picking_id" column_invisible="1"/>
                                <field name="packaging_type_id" options="{'no_open': True, 'no_create': True}"/>
                                <field name="move_type_sap"/>
                                <!-- <field name="sloc_packaging"/> -->
                                <field name="sloc_id"/>
                                <field name="product_id" options="{'no_open': True, 'no_create': True}"/>
                                <field name="qty_packaging_sap"/>
                                <field name="product_uom_desc"/>
                                <field name="packaging_code"/>
                                <field name="packaging_desc"/>
                                <field name="company_id" options="{'no_open': True, 'no_create': True}"/>
                            </list>
                            <form create="0" edit="0" delete="0">
                                <group>
                                    <field name="picking_id" column_invisible="1"/>
                                    <field name="packaging_type_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="move_type_sap"/>
                                    <field name="sloc_id"/>
                                    <field name="product_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="qty_packaging_sap"/>
                                    <field name="product_uom_desc"/>
                                    <field name="packaging_code"/>
                                    <field name="packaging_desc"/>
                                    <field name="company_id" options="{'no_open': True, 'no_create': True}"/>
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>