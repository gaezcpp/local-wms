<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="inherit_base_stock_location_form">
            <field name="name">inherit.base.stock.location.form</field>
            <field name="model">stock.location</field>
            <field name="inherit_id" ref="stock.view_location_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='barcode']" position="after">
                    <field name="sloc_name" placeholder="e.g FINI" required="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>