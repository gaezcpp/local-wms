<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="inherit_base_res_users_form">
            <field name="name">inherit.base.res.users.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='page_security']" position="after">
                    <page name="page_wh_types" string="WH Types">
                        <group string="Operation Types">
                            <field name="picking_type_ids" widget="many2many_tags" options="{'no_create': True, 'color_field': 'color'}" domain="[('company_id', 'in', company_ids)]"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>