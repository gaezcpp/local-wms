<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="inherit_base_stock_move_line_operation_tree_views">
            <field name="name">base.inherit.stock.move.line.tree</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='quant_id']" position="before">
                    <field name="production_line_id" options="{'no_open': True, 'no_create': True}"/>
                    <!-- <field name="first_count"/> -->
                    <!-- <field name="last_count"/> -->
                    <field name="detail_text"/>
                </xpath>
                <xpath expr="//field[@name='location_dest_id']" position="after">
                    <field name="sloc_id" options="{'no_open': True, 'no_create': True}" readonly="1"/>
                </xpath>
                <xpath expr="//field[@name='lot_id']" position="after">
                    <field name="stock_type" readonly="1"/>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="inherit_view_move_line_form">
            <field name="name">inherit.view.move.line.form</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_form"/>
            <field name="arch" type="xml">
                <!--PEMBATASAN USER-->
                <xpath expr="//field[@name='product_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='location_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='location_dest_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='product_uom_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='lot_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='package_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='result_package_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='create_uid']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>