<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="inherit_base_stock_move_line_operation_tree_views">
            <field name="name">base.inherit.stock.move.line.tree</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lot_id']" position="before">
                    <field name="production_line_id" options="{'no_open': True, 'no_create': True}"/>
                    <field name="first_count"/>
                    <field name="last_count"/>
                    <field name="detail_text"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>