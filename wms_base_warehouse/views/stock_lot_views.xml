<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="base_warehouse_stock_lot_form">
            <field name="name">base.warehouse.stock.lot.form</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='ref']" position="before">
                    <field name="production_line_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                </xpath>
                <xpath expr="//group[@name='main_group']" position="after">
                    <field name="lot_aft_ids" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="stock_type"/>
                            <field name="quantity"/>
                            <field name="uom_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="bag_qty"/>
                            <field name="uom_bag_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="lot_id" options="{'no_open': True, 'no_create': True}" column_invisible="1"/>
                        </list>
                        <form create="0" edit="0" delete="0">
                            <group>
                                <field name="stock_type"/>
                                <field name="quantity"/>
                                <field name="uom_id" options="{'no_open': True, 'no_create': True}"/>
                                <field name="bag_qty"/>
                                <field name="uom_bag_id" options="{'no_open': True, 'no_create': True}"/>
                                <field name="lot_id" options="{'no_open': True, 'no_create': True}" column_invisible="1"/>
                            </group>
                        </form>
                    </field>
                </xpath>
            </field>
        </record>
    </data>
</odoo>