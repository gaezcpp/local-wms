<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="food_production_order_search">
        <field name="name">food.production.order.search</field>
        <field name="model">food.production.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="order_type"/>
                <field name="state"/>
                <field name="product_id"/>
                <field name="company_id"/>
            </search>
        </field>
    </record>

    <record id="food_production_order_view_list" model="ir.ui.view">
        <field name="name">food.production.order.view.list</field>
        <field name="model">food.production.order</field>
        <field name="arch" type="xml">
            <list string="Production Order" create="0" edit="0" delete="0" duplicate="0">
                <field name="name"/>
                <field name="order_type"/>
                <field name="product_id"/>
                <field name="uom_id"/>
                <field name="order_qty"/>
                <field name="start_date"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="food_production_order_view_form" model="ir.ui.view">
        <field name="name">food.production.order.view.form</field>
        <field name="model">food.production.order</field>
        <field name="arch" type="xml">
            <form string="Production Order" create="0" edit="0" delete="0" duplicate="0">
                <sheet>
                    <header>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <label for="name" class="oe_edit_only"/>
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="order_type"/>
                            <field name="product_id"/>
                            <field name="uom_id"/>
                            <field name="start_date"/>
                            <field name="company_id" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                        <group>
                            <field name="order_qty"/>
                            <field name="gr_qty"/>
                            <field name="remaining_qty"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="food_production_order_action" model="ir.actions.act_window">
        <field name="name">Production Order</field>
        <field name="res_model">food.production.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>