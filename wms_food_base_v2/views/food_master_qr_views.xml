<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="food_master_qr_search">
        <field name="name">food.master.qr.search</field>
        <field name="model">food.master.qr</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="client_no"/>
                <field name="product_id"/>
                <field name="prod_code"/>
            </search>
        </field>
    </record>

    <record id="food_master_qr_view_list" model="ir.ui.view">
        <field name="name">food.master.qr.view.list</field>
        <field name="model">food.master.qr</field>
        <field name="arch" type="xml">
            <list string="Master QR" create="0" edit="0" delete="0" duplicate="0">
                <field name="name"/>
                <field name="client_no"/>
                <field name="product_id" options="{'no_open': True, 'no_create': True}"/>
                <field name="prod_code"/>
                <field name="prod_order_no"/>
                <field name="mat_group"/>
                <field name="md_code"/>
                <field name="batch_no"/>
                <field name="company_id" options="{'no_open': True, 'no_create': True}"/>
            </list>
        </field>
    </record>

    <record id="food_master_qr_view_form" model="ir.ui.view">
        <field name="name">food.master.qr.view.form</field>
        <field name="model">food.master.qr</field>
        <field name="arch" type="xml">
            <form string="Master QR" create="0" edit="0" delete="0" duplicate="0">
                <sheet>
                    <label for="name" class="oe_edit_only"/>
                    <h1>
                        <field name="name" force_save="1" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="client_no"/>
                            <field name="mat_group"/>
                            <field name="md_code"/>
                            <field name="batch_no"/>
                            <field name="product_id"/>
                            <field name="company_id"/>
                            <field name="last_sync"/>
                            <field name="scrap_datetime"/>
                            <field name="scrap_status"/>
                        </group>
                        <group>
                            <field name="prod_code"/>
                            <field name="prod_order_no"/>
                            <field name="prod_date"/>
                            <field name="prod_group"/>
                            <field name="harvest_date"/>
                            <field name="pack_date"/>
                            <field name="pack_group"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="food_master_qr_action" model="ir.actions.act_window">
        <field name="name">Master QR</field>
        <field name="res_model">food.master.qr</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>