<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="food_production_group_search">
        <field name="name">food.production.group.search</field>
        <field name="model">food.production.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <record id="food_production_group_view_list" model="ir.ui.view">
        <field name="name">food.production.group.view.list</field>
        <field name="model">food.production.group</field>
        <field name="arch" type="xml">
            <list string="Production Group">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="food_production_group_view_form" model="ir.ui.view">
        <field name="name">food.production.group.view.form</field>
        <field name="model">food.production.group</field>
        <field name="arch" type="xml">
            <form string="Production Group">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="company_id" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="food_production_group_action" model="ir.actions.act_window">
        <field name="name">Production Group</field>
        <field name="res_model">food.production.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>