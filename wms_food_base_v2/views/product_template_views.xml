<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="food_inherit_product_template_form_views">
            <field name="name">food.inherit.product.template.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='type']" position="after">
                    <field name="uom_package_id"/>
                    <field name="uom_pallet_id"/>
                    <field name="sap_sync" readonly="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>