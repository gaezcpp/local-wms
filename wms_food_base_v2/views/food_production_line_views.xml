<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="food_production_line_search">
        <field name="name">food.production.line.search</field>
        <field name="model">food.production.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="line_code"/>
                <field name="company_id"/>
                <filter name="fl_archived" string="Archived" domain="[('active','=', False)]"/>
            </search>
        </field>
    </record>

    <record id="food_production_line_view_list" model="ir.ui.view">
        <field name="name">food.production.line.view.list</field>
        <field name="model">food.production.line</field>
        <field name="arch" type="xml">
            <list string="Production Line" create="0" edit="0" delete="0" duplicate="0">
                <field name="name"/>
                <field name="code"/>
                <field name="line_code"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="food_production_line_view_form" model="ir.ui.view">
        <field name="name">food.production.line.view.form</field>
        <field name="model">food.production.line</field>
        <field name="arch" type="xml">
            <form string="Production Line"  create="0" edit="0" delete="0" duplicate="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="line_code"/>
                            <field name="sap_sync"/>
                            <field name="company_id" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="food_production_line_action" model="ir.actions.act_window">
        <field name="name">Production Line</field>
        <field name="res_model">food.production.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>