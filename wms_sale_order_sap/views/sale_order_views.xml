<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="inherit_wms_sale_order_search_view">
            <field name="name">inherit.wms.sale.order.search</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sales_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="before">
                    <field name="do_sap"/>
                    <field name="po_sap"/>
                    <field name="so_sap"/>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="inherit_wms_sale_order_tree_views">
            <field name="name">inherit.wms.sale.order.tree</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_id']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='activity_ids']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="do_sap"/>
                    <field name="po_sap"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="sales_sap_name"/>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="inherit_wms_sale_order_form_views">
            <field name="name">inherit.wms.sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date_order']" position="after">
                    <field name="date_order_sap" force_save="1" readonly="1" string="SAP Order Date"/>
                </xpath>
                <xpath expr="//field[@name='partner_shipping_id']" position="after">
                    <field name="so_sap" force_save="1" readonly="1"/>
                    <field name="do_sap" force_save="1" readonly="1"/>
                    <field name="po_sap" force_save="1" readonly="1"/>
                    <field name="sloc_to" force_save="1" readonly="1"/>
                    <field name="carrier_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                </xpath>
                <xpath expr="//field[@name='order_line']/list/field[@name='currency_id']" position="after">
                    <field name="sap_sequence" readonly="1" optional="show"/>
                    <field name="order_seq" readonly="1" optional="show"/>
                    <field name="order_selection" readonly="1" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='order_line']/list" position="attributes">
                    <attribute name="default_order">order_seq asc</attribute>
                </xpath>
                <xpath expr="//page[@name='other_information']" position="before">
                    <page string="SAP Information">
                        <group>
                            <group name="sc_left">
                                <field name="is_sap" string="SAP Synhronize" readonly="1"/>
                                <field name="so_sap" readonly="1"/>
                                <field name="do_sap" readonly="1"/>
                                <field name="po_sap" readonly="1"/>
                                <field name="sales_sap_name" readonly="1"/>
                                <label for="nomor_polisi_desc" string="Nomor Polisi" class="oe_grey"/>
                                <div style="border: 1px solid #ccc; padding: 6px; margin-bottom: 12px; max-height: 180px; overflow-y: auto; background: #fafafa;">
                                    <field name="nomor_polisi_desc" readonly="1"/>
                                </div>
                            </group>
                            <group name="sc_right">
                                <field name="aft_mat_doc" readonly="1"/>
                                <field name="aft_mat_doc_year" readonly="1"/>
                                <field name="date_order_sap" readonly="1"/>
                                <field name="so_sto" readonly="1"/>
                                <field name="sloc_to_sloc" readonly="1"/>
                                <field name="sloc_to" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
                <!--PEMBATASAN USER-->
                <xpath expr="//form" position="attributes">
                    <attribute name="create">0</attribute>
                    <attribute name="edit">0</attribute>
                    <attribute name="delete">0</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='payment_term_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='tag_ids']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='team_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='company_id'][@groups='base.group_multi_company']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='warehouse_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='incoterm']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='campaign_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='medium_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='source_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/form" position="attributes">
                    <attribute name="create">0</attribute>
                    <attribute name="edit">0</attribute>
                    <attribute name="delete">0</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/list" position="attributes">
                    <attribute name="create">0</attribute>
                    <attribute name="edit">0</attribute>
                    <attribute name="delete">0</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/list/control" position="replace">
                </xpath>
                <xpath expr="//field[@name='order_line']/kanban" position="attributes">
                    <attribute name="create">0</attribute>
                    <attribute name="edit">0</attribute>
                    <attribute name="delete">0</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/kanban/control" position="replace">
                </xpath>
            </field>
        </record>
    </data>
</odoo>