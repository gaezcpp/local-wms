<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="wms_stock_picking_sale_form">
            <field name="name">wms.so.stock.picking.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='move_type']" position="after">
                    <field name="aft_mat_doc" readonly="1"/>
                    <field name="aft_mat_doc_year" readonly="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>