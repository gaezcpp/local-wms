<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pm_notification_wizard_form_views" model="ir.ui.view">
        <field name="name">pm.notification.wizard.form.views</field>
        <field name="model">pm.notification.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="tagging_id" force_save="1" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                        <field name="company_id" force_save="1" readonly="1" options="{'no_open': True, 'no_create': True}" invisible="1"/>
                    </group>
                </group>
                <group name="tag_notif" string="Notification">
                    <field name="tagging_type_notification_id" options="{'no_open': True, 'no_create': True}" domain="[('company_id', '=', company_id)]"/>
                    <field name="notification_desc" force_save="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" confirm="Pastikan data sudah sesuai!" type="object" default_focus="1" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
