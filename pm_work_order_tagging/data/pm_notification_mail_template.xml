<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_pm_notification_created" model="mail.template">
            <field name="name">PM: Notification Created</field>
            <field name="model_id" ref="tagging_system.model_tagging_record"/>
            <field name="subject">New PM Notification [{{ object.nomor_notifikasi or object.name }}]</field>
            <field name="email_from">noreply-ops@cpp.co.id</field>
            <field name="email_to" eval="False"/>
            <field name="partner_to" eval="False"/>
            <field name="description">Notify maintenance planner after PM notification confirmation.</field>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #333333;">
    <p>Dear Maintenance Planner,</p>
    <p>This is to inform you that a new PM Notification has been created in SAP.</p>
    <p><strong>Notification Details:</strong></p>
    <ul>
        <li><strong>Notification Number:</strong> <t t-out="object.nomor_notifikasi or object.name or '-'">TSP-0001</t></li>
        <li><strong>Notification Type:</strong> <t t-out="object.tagging_type_notification_id.display_name or '-'">Notification Type</t></li>
        <li><strong>Plant:</strong> <t t-out="object.company_id.company_registry or object.plant_name or '-'">Plant</t></li>
        <li><strong>System:</strong> <t t-out="object.system_id.display_name or object.system_name or '-'">System</t></li>
        <li><strong>Sub System:</strong> <t t-out="object.sub_system_id.display_name or object.sub_system_name or '-'">Sub System</t></li>
        <li><strong>Equipment:</strong> <t t-out="object.parent_equipment_id.display_name or '-'">Equipment</t></li>
        <li><strong>Sub Equipment:</strong> <t t-out="object.equipment_id.display_name or '-'">Sub Equipment</t></li>
        <li><strong>Created By:</strong> <t t-out="object.create_uid.display_name or '-'">Created By</t></li>
        <li><strong>Created Date:</strong> <t t-out="object.create_date and format_datetime(object.create_date, tz='Asia/Jakarta') or '-'">Created Date</t></li>
    </ul>
    <p>Please review the notification details and proceed with the necessary planning activities in accordance with the maintenance process.</p>
    <p>Thank you for your attention and cooperation.</p>
    <p>Best regards,<br/>Plant Maintenance System</p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
