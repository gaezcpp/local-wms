<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="pm_work_order_search">
        <field name="name">pm.work.order.search</field>
        <field name="model">pm.work.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="wo_sap"/>
                <field name="type_mo"/>
                <field name="tagging_id"/>
                <field name="company_id"/>
                <field name="name"/>
                <filter name="fl_archived" string="Archived" domain="[('active','=', False)]"/>
                <filter name="fl_preventif" string="Preventif" domain="[('preventif_inspection','=', True)]"/>
                <group>
                    <filter name="gr_type" string="By Type" context="{'group_by':'type_mo'}"/>
                    <filter name="gr_state" string="By State" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="pm_work_order_view_list" model="ir.ui.view">
        <field name="name">pm.work.order.view.list</field>
        <field name="model">pm.work.order</field>
        <field name="arch" type="xml">
            <list string="Work Order" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="tagging_id"/>
                <field name="wo_sap"/>
                <field name="type_mo"/>
                <field name="system_id"/>
                <field name="sub_system_id"/>
                <field name="equipment_id"/>
                <field name="sub_equipment_id"/>
                <field name="state" wdiget="badge" decoration-danger="state == 'draft'" decoration-warning="state == 'waiting_sap'" decoration-success="state == 'confirm'"/>
                <field name="priority"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="pm_work_order_view_form" model="ir.ui.view">
        <field name="name">pm.work.order.view.form</field>
        <field name="model">pm.work.order</field>
        <field name="arch" type="xml">
            <form string="Work Order" create="0" delete="0">
                <header>
                    <button name="action_waiting_sap" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft' or not gi_gr_done"/>
                    <!-- <button name="action_close" string="Close" type="object" class="oe_highlight" invisible="state != 'waiting_sap'"/> -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting_sap,confirm"/>
                </header>
                <sheet>
                    <h1 invisible="not description">
                        <field name="description" readonly="1"/>
                    </h1>
                    <h2>
                        <field name="name" readonly="1"/>
                    </h2>
                    <group>
                        <group name="pm_left">
                            <field name="wo_sap" readonly="1"/>
                            <field name="maintenance_plan_number" readonly="1" invisible="not maintenance_plan_number"/>
                            <field name="is_maintenance_plan" readonly="1" invisible="not is_maintenance_plan"/>
                            <field name="tagging_id" readonly="1" invisible="not tagging_id"/>
                            <field name="type_mo" force_save="1" readonly="1"/>
                            <field name="priority" force_save="1" readonly="1"/>
                            <field name="confirm_number" force_save="1" readonly="1" invisible="not confirm_number"/>
                            <field name="sap_synchronize" force_save="1" readonly="1" invisible="1"/>
                            <field name="gi_gr_done" invisible="1" readonly="1"/>
                            <field name="material_only" invisible="1" readonly="1"/>
                            <field name="jasa_only" invisible="1" readonly="1"/>
                            <field name="preventif_visible" readonly="1"/>
                            <field name="preventif_inspection" readonly="1"/>
                            <field name="is_maintenance_plan" readonly="1"/>
                        </group>
                        <group name="pm_right">
                            <field name="system_id" options="{'no_open': True, 'no_create': True}" force_save="1" readonly="1"/>
                            <field name="sub_system_id" options="{'no_open': True, 'no_create': True}" force_save="1" readonly="1"/>
                            <field name="equipment_id" options="{'no_open': True, 'no_create': True}" force_save="1" readonly="1"/>
                            <field name="sub_equipment_id" options="{'no_open': True, 'no_create': True}" force_save="1" readonly="1"/>
                            <field name="company_id" options="{'no_open': True, 'no_create': True}" force_save="1" readonly="1"/>
                            <field name="start_time" force_save="1" readonly="1"/>
                            <field name="end_time" force_save="1" readonly="1" invisible="end_time == start_time"/>
                        </group>
                    </group>
                    <notebook invisible="preventif_inspection and not is_maintenance_plan">
                        <page name="material" string="Material" invisible="not material_only">
                            <field name="pm_wo_material_line_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="pm_work_order_id" column_invisible="1"/>
                                    <field name="item_number"/>
                                    <field name="product_sparepart_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="product_material"/>
                                    <field name="quantity"/>
                                    <field name="is_gi"/>
                                    <field name="gi_doc"/>
                                    <field name="valuation"/>
                                    <field name="material_detail"/>
                                </list>
                                <form create="0" edit="0" delete="0">
                                    <field name="pm_work_order_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                                </form>
                            </field>
						</page>
                        <page name="jasa" string="Jasa" invisible="not jasa_only">
                            <field name="pm_wo_jasa_line_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="pm_work_order_id" column_invisible="1"/>
                                    <field name="material_desc"/>
                                    <field name="sku_desc"/>
                                    <field name="is_gr"/>
                                    <field name="gr_doc"/>
                                </list>
                                <form create="0" edit="0" delete="0">
                                    <field name="pm_work_order_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                                </form>
                            </field>
						</page>
					</notebook>
                    <div name="description_planning_wptxt" class="alert alert-info" role="status" invisible="not is_maintenance_plan or not description_planning">
                        <field name="description_planning" readonly="1"/>
                    </div>
                    <div name="close_evidence_warning" class="alert alert-info" role="status" invisible="not sap_synchronize or gi_gr_done">
                        Close Evidence belum bisa diisi karena masih ada material yang belum GI atau jasa yang belum GR.
                    </div>
                    <separator name="close_evidence" string="Close Evidence" invisible="not sap_synchronize or not gi_gr_done"/>
                    <group name="close_evidence" invisible="not sap_synchronize or not gi_gr_done">
                        <field name="need_desc" invisible="1" force_save="1" readonly="1"/>
                        <field name="date_from" readonly="state != 'draft'"/>
                        <field name="date_to" readonly="state != 'draft'"/>
                        <!-- <field name="analysis_id" domain="[('company_id', '=', company_id)]" readonly="state != 'draft'" context="{'default_company_id': company_id}"/> -->
                        <field name="analysis_id" domain="['|', ('company_id', '=', company_id), ('company_id', '=', False)]" readonly="state != 'draft'"/>
                        <field name="analysis" readonly="state != 'draft'" invisible="not need_desc" required="need_desc"/>
                        <field name="problem_handling" readonly="state != 'draft'"/>
                        <field name="photo_attachment" readonly="state != 'draft'" widget="image" options="{'size': [128, 128]}"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="pm_work_order_view_form_calendar_only" model="ir.ui.view">
        <field name="name">pm.work.order.view.form.calendar.only</field>
        <field name="model">pm.work.order</field>
        <field name="inherit_id" ref="pm_work_order_tagging.pm_work_order_view_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='close_evidence_warning']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//separator[@name='close_evidence']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='close_evidence']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- <xpath expr="//button[@name='action_waiting_sap']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_close']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath> -->
        </field>
    </record>

    <record id="pm_work_order_view_calendar" model="ir.ui.view">
        <field name="name">pm.work.order.view.calendar</field>
        <field name="model">pm.work.order</field>
        <field name="arch" type="xml">
            <calendar string="WO Calendar" create="0" edit="0" delete="0"
                     date_start="start_time"
                     date_stop="end_time"
                     create_name_field="calendar_display_name"
                     color="wo_sap"
                    quick_create="0"
                    mode="month"
                    event_open_popup="true"
                    form_view_id="%(pm_work_order_tagging.pm_work_order_view_form_calendar_only)d">
                 <field name="wo_sap"/>
                 <field name="calendar_display_name" invisible="1"/>
                 <field name="system_id" options="{'no_open': True, 'no_create': True}"/>
                <field name="sub_system_id" options="{'no_open': True, 'no_create': True}"/>
                <field name="equipment_id" options="{'no_open': True, 'no_create': True}"/>
                <field name="sub_equipment_id" options="{'no_open': True, 'no_create': True}"/>
            </calendar>
        </field>
    </record>

    <record id="pm_work_order_action" model="ir.actions.act_window">
        <field name="name">Work Order</field>
        <field name="res_model">pm.work.order</field>
        <field name="view_mode">list,calendar,form</field>
        <!-- <field name="domain">[('preventif_visible', '=', True)]</field> -->
        <field name="domain">[('is_maintenance_plan', '=', False)]</field>
    </record>

    <record id="pm_work_order_calendar_action" model="ir.actions.act_window">
        <field name="name">Work Order Calendar</field>
        <field name="res_model">pm.work.order</field>
        <field name="view_mode">calendar,form</field>
    </record>
    
</odoo>
