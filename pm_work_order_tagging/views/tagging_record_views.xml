<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="tagging_record_form">
            <field name="name">inherit.tagging.record.form</field>
            <field name="model">tagging.record</field>
            <field name="inherit_id" ref="tagging_system.view_tagging_record_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_set_wo']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='action_set_wo']" position="after">
                    <button name="action_set_create_work_order" type="object" string="Set Work Order" class="oe_highlight" invisible="status != 'validated'"/>
                </xpath>
                <xpath expr="//group[@name='tag_equipment']" position="before">
                    <group name="tag_notif" string="Notification" invisible="status not in ('validated','open_wo','closed')">
                        <field name="tagging_type_notification_id" options="{'no_open': True, 'no_create': True}"/>
                        <field name="notification_desc" force_save="1" readonly="1"/>
                    </group>
                </xpath>
                <xpath expr="//field[@name='functional_location']" position="after">
                    <field name="nomor_notifikasi" force_save="1" readonly="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>