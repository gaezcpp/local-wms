<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="tagging_type_notification_search">
        <field name="name">tagging.type.notification.search</field>
        <field name="model">tagging.type.notification</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="tagging_type_notification_view_list" model="ir.ui.view">
        <field name="name">tagging.type.notification.view.list</field>
        <field name="model">tagging.type.notification</field>
        <field name="arch" type="xml">
            <list string="Tagging Type Notification">
                <field name="name"/>
                <field name="desc"/>
            </list>
        </field>
    </record>

    <record id="tagging_type_notification_view_form" model="ir.ui.view">
        <field name="name">tagging.type.notification.view.form</field>
        <field name="model">tagging.type.notification</field>
        <field name="arch" type="xml">
            <form string="Tagging Type Notification">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="desc"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tagging_type_notification_action" model="ir.actions.act_window">
        <field name="name">Tagging Type Notification</field>
        <field name="res_model">tagging.type.notification</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>