<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="pm_analysis_search">
        <field name="name">pm.analysis.search</field>
        <field name="model">pm.analysis</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <filter name="fl_need_desc" string="Need Description" domain="[('need_desc','=', True)]"/>
                <filter name="fl_active" string="Active" domain="[('active','=', True)]"/>
            </search>
        </field>
    </record>

    <record id="pm_analysis_view_list" model="ir.ui.view">
        <field name="name">pm.analysis.view.list</field>
        <field name="model">pm.analysis</field>
        <field name="arch" type="xml">
            <list string="Analysis">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="need_desc"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="pm_analysis_view_form" model="ir.ui.view">
        <field name="name">pm.analysis.view.form</field>
        <field name="model">pm.analysis</field>
        <field name="arch" type="xml">
            <form string="Analysis">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="company_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                            <field name="need_desc"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pm_analysis_action" model="ir.actions.act_window">
        <field name="name">PM Analysis</field>
        <field name="res_model">pm.analysis</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>