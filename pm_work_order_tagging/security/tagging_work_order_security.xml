<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_tagging_work_order">
            <field name="name">Tagging Work Order</field>
            <field name="sequence">50</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_tagging_work_order">
            <field name="name">Tagging Work Order</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="pm_work_order_tagging.module_tagging_work_order"/>
        </record>

        <record id="group_tagging_work_order_production" model="res.groups">
            <field name="name">Production</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_tagging_work_order"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_tagging_work_order_maintenance" model="res.groups">
            <field name="name">Maintenance</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_tagging_work_order"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_tagging_work_order_planner" model="res.groups">
            <field name="name">Planner</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_tagging_work_order"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_tagging_work_order_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="res_groups_privilege_tagging_work_order"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="tagging_record_rule_production_department" model="ir.rule">
            <field name="name">Tagging: Production department only</field>
            <field name="model_id" ref="tagging_system.model_tagging_record"/>
            <field name="groups" eval="[(4, ref('group_tagging_work_order_production'))]"/>
            <field name="domain_force">[('department_id.department_type', '=', 'production')]</field>
        </record>
    </data>
</odoo>
