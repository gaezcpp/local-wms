<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="tagging_system.TaggingDashboard" owl="1">
    <div class="o_tagging_dash">

      <!-- HERO -->
      <div class="dash-hero">
        <div class="hero-left">
          <div class="hero-title">Tagging System Machine</div>
          <div class="hero-sub">Progressing towards achieving the best maintenance process</div>
        </div>
        <div class="hero-filters hero-filters--dark"
        t-att-class="filters.date_range === 'custom' ? 'is-custom' : 'is-preset'">
          <!-- Date Range -->
          <div class="d-flex flex-column" style="min-width: 180px;">
            <small class="text-white">Date range</small>
            <select class="form-select form-select-sm"
                    t-model="filters.date_range"
                    t-on-change="onDateRangeChange">
              <t t-foreach="options.date_ranges" t-as="r" t-key="r.key">
                <option t-att-value="r.key"><t t-esc="r.label"/></option>
              </t>
            </select>
          </div>
        
          <t t-if="filters.date_range === 'custom'">
            <!-- From -->
            <div class="d-flex flex-column" style="min-width: 160px;">
              <small class="text-white">From</small>
              <input type="date"
                     class="form-control form-control-sm"
                     t-model="filters.date_from"
                     t-on-change="onFromDateChange"/>
            </div>

            <!-- To -->
            <div class="d-flex flex-column" style="min-width: 160px;">
              <small class="text-white">To</small>
              <input type="date"
                     class="form-control form-control-sm"
                     t-model="filters.date_to"
                     t-on-change="onToDateChange"/>
            </div>

            <!-- Apply -->
            <div class="d-flex flex-column" style="min-width: 110px;">
              <small class="text-muted">&#160;</small>
              <button class="btn btn-sm btn-primary"
                      t-on-click="applyCustomRange"
                      t-att-disabled="!filters.date_from || !filters.date_to || filters.date_from > filters.date_to">
                Apply
              </button>
            </div>
          </t>
        
        </div>
        
        
      </div>

      <!-- PERFORMANCE METRICS -->
      <div class="card perf shadow-sm border-0">
        <div class="card-body">
          <div class="perf-title">Performance Metrics</div>

          <div class="perf-grid">
            <div class="perf-item">
              <div class="perf-label">Total Tagging</div>
              <div class="perf-value"><t t-esc="state.metrics.total"/></div>
            </div>

            <div class="perf-item" t-att-title="'Quantity: ' + (state.metrics.closed || 0)">
              <div class="perf-label">% Validated</div>
              <div class="perf-value text-danger d-flex align-items-center justify-content-center gap-2">
                <span><t t-esc="(state.metrics.pct_closed || 0).toFixed(2)"/>%</span>
                <span style="font-weight: 400; color: #d1d5db;">|</span>
                <span><t t-esc="state.metrics.closed || 0"/></span>
              </div>
            </div>

            <div class="perf-item" t-att-title="'Quantity: ' + (state.metrics.not_valid || 0)">
              <div class="perf-label">% Not Valid</div>
              <div class="perf-value d-flex align-items-center justify-content-center gap-2">
                <span><t t-esc="(state.metrics.pct_not_valid || 0).toFixed(2)"/>%</span>
                <span style="font-weight: 400; color: #d1d5db;">|</span>
                <span><t t-esc="state.metrics.not_valid || 0"/></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ROW 1 -->
      <div class="grid-2">
        <div class="card shadow-sm border-0">
          <div class="card-body">
            <div class="card-title-sm">Total Tagging by System</div>
            <div class="chart-box">
              <canvas t-ref="chartSystem"></canvas>
            </div>
          </div>
        </div>

        <div class="card shadow-sm border-0">
          <div class="card-body">
            <div class="card-title-sm">Total Tagging by Category Problem</div>
            <div class="chart-box">
              <canvas t-ref="chartProblem"></canvas>
            </div>
          </div>
        </div>
      </div>

      <!-- ROW 2 (CHARTS) -->
<div class="grid-2 mt-3">
  <div class="card shadow-sm border-0">
    <div class="card-body">
      <div class="card-title-sm">Total Tagging by ABC Class. &amp; System</div>
      <div class="text-muted small mb-2">
        ABC Indicator → System
      </div>
      <div class="chart-box treemap-box">
        <canvas t-ref="chartTreemap"></canvas>
      </div>
    </div>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body">
      <div class="card-title-sm">% Closed &amp; Not Closed based on ABC</div>

      <div class="abc-table">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr>
              <th style="width: 160px;">ABC Indicator</th>
              <th style="width: 120px;">Total Tagging</th>
              <th>% Closed</th>
              <th>% Not Closed</th>
            </tr>
          </thead>
          <tbody>
            <t t-foreach="state.abc_table" t-as="row" t-key="row.abc">
              <tr>
                <td><t t-esc="row.abc"/></td>
                <td><t t-esc="row.total"/></td>
                <td>
                  <div class="bar bar-closed" t-att-style="'--w:' + (row.pct_closed || 0) + '%;'">
                    <span><t t-esc="(row.pct_closed || 0).toFixed(2)"/>%</span>
                  </div>
                </td>
                <td>
                  <div class="bar bar-not" t-att-style="'--w:' + (row.pct_not_closed || 0) + '%;'">
                    <span><t t-esc="(row.pct_not_closed || 0).toFixed(2)"/>%</span>
                  </div>
                </td>
              </tr>
            </t>
          </tbody>
        </table>
      </div>

    </div>
  </div>
</div>

      <!-- ROW 2 -->
      <div class="row g-2">
        <t t-foreach="Object.entries(state.abc_system_grouping || {})" t-as="kv" t-key="kv[0]">
          <t t-set="abcKey" t-value="kv[0]"/>
          <t t-set="rows" t-value="kv[1]"/>
      
          <div class="col-12 col-lg-6">
            <div class="p-2 rounded border bg-light">
              <div class="d-flex align-items-center justify-content-between mb-1">
                <div class="fw-bold">
                  Category <t t-esc="abcKey"/>
                </div>
                <div class="text-muted small">
                  Total:
                  <t t-esc="(rows || []).reduce((s, r) => s + (r.count || 0), 0)"/>
                </div>
              </div>
      
              <table class="table table-sm mb-0">
                <thead>
                  <tr>
                    <th>System</th>
                    <th class="text-end" style="width: 90px;">Count</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-foreach="rows || []" t-as="r" t-key="r.system">
                    <tr>
                      <td class="text-truncate" style="max-width: 220px;">
                        <t t-esc="r.system"/>
                      </td>
                      <td class="text-end"><t t-esc="r.count"/></td>
                    </tr>
                  </t>
                  <t t-if="!(rows || []).length">
                    <tr><td colspan="2" class="text-muted">No data</td></tr>
                  </t>
                </tbody>
              </table>
            </div>
          </div>
        </t>
      </div>
      

    </div>
  </t>
</templates>