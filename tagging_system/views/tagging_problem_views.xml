<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Search View -->
    <record model="ir.ui.view" id="tagging_problem_search">
        <field name="name">tagging.problem.search</field>
        <field name="model">tagging.problem</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="tagging_problem_view_list" model="ir.ui.view">
        <field name="name">tagging.problem.view.list</field>
        <field name="model">tagging.problem</field>
        <field name="arch" type="xml">
            <list string="Tagging Problem">
                <field name="code"/>
                <field name="code_group"/>
                <field name="name"/>
                <field name="sap_synchronize"/>
            </list>
        </field>
    </record>

    <record id="tagging_problem_view_form" model="ir.ui.view">
        <field name="name">tagging.problem.view.form</field>
        <field name="model">tagging.problem</field>
        <field name="arch" type="xml">
            <form string="Tagging Problem" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="code_group"/>
                            <field name="name"/>
                            <field name="sap_synchronize"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tagging_problem_action" model="ir.actions.act_window">
        <field name="name">Tagging problem</field>
        <field name="res_model">tagging.problem</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
