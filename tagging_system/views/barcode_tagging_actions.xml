<odoo>
    <!-- Server Action: Generate QR dari list -->
    <record id="server_action_barcode_tagging_generate_qr" model="ir.actions.server">
        <field name="name">Generate QR</field>
        <field name="model_id" ref="model_barcode_tagging"/>
        <field name="binding_model_id" ref="model_barcode_tagging"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_generate_qr()
        </field>
    </record>
</odoo>
