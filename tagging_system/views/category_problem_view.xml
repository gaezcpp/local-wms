<odoo>
    <record id="action_category_problem" model="ir.actions.act_window">
        <field name="name">Category Problem</field>
        <field name="res_model">category.problem</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_category_problem_list" model="ir.ui.view">
        <field name="name">category.problem.list</field>
        <field name="model">category.problem</field>
        <field name="arch" type="xml">
            <list string="Category Problem">
                <field name="system_id"/>
                <field name="subsystem_id"/>
                <field name="problem_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_category_problem_form" model="ir.ui.view">
        <field name="name">category.problem.form</field>
        <field name="model">category.problem</field>
        <field name="arch" type="xml">
            <form string="Category Problem">
                <sheet>
                    <group>
                        <group string="Classification">
                            <field name="system_id" options="{'no_open': True, 'no_create': True}" domain="[('company_id', '=', allowed_company_ids[0])]"/>
                            <field name="subsystem_id" domain="[('system_id', '=', system_id)]" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                        <group string="Details">
                            <field name="cat_masalah" force_save="1" readonly="1"/>
                            <field name="problem_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
