<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_tagging_wo_sparepart_wizard_form" model="ir.ui.view">
    <field name="name">tagging.wo.sparepart.wizard.form</field>
    <field name="model">tagging.wo.sparepart.wizard</field>
    <field name="arch" type="xml">
      <form string="Spare Part">
        <sheet>
          <group>
            <field name="record_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
            <field name="equipment_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
            <field name="allowed_spare_part_ids" invisible="1" />
            <!-- <field name="remarks" placeholder="Isi catatan sebelum confirm..." required="1" /> -->
          </group>
          <field name="line_ids">
            <list editable="bottom">
              <field name="spare_part_id" context="{'display_name_only': 1}" options="{'no_open': True, 'no_create': True}"  domain="[('id','in', parent.allowed_spare_part_ids)]"/>
              <field name="qty"  />
              <field name="sku" readonly="1" />
              <field name="remarks" />
            </list>
          </field>
          <footer>
            <button string="Confirm" type="object" name="action_confirm" class="btn-primary" />
            <button string="Cancel" class="btn-secondary" special="cancel" />
          </footer>
        </sheet>
      </form>
    </field>
  </record>
</odoo>