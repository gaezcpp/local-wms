<odoo>

  <!-- ===================== SEARCH VIEW ===================== -->
  <record id="view_tagging_record_search" model="ir.ui.view">
    <field name="name">tagging.record.search</field>
    <field name="model">tagging.record</field>
    <field name="arch" type="xml">
      <search string="Search Tagging">
        <field name="name" />
        <field name="plant_code" />
        <!-- <field name="pic_department_names" /> -->
        <field name="department_id" />
        <field name="category_problem_id" />
        <field name="status" />
        <separator />
        <filter string="Open" name="flt_open" domain="['|',('status','=','open'),('status','=','open_wo')]" />
        <filter string="Validated" name="flt_validated" domain="[('status','=','validated')]" />
        <filter string="Closed" name="flt_closed" domain="[('status','=','closed')]" />
        <separator />
        <field name="active" invisible="1" />
        <filter string="Archived" name="archived" domain="[('active','=',False)]" />
        <filter string="Active" name="active_only" domain="[('active','=',True)]" context="{'search_default_active_only': 1}" />
        <separator />
        <filter string="Group by Status" name="grp_status" context="{'group_by': 'status'}" />
        <filter string="Group by Plant" name="grp_plant" context="{'group_by': 'plant_code'}" />
      </search>
    </field>
  </record>

  <record id="view_tagging_record_list" model="ir.ui.view">
    <field name="name">tagging.record.list</field>
    <field name="model">tagging.record</field>
    <field name="arch" type="xml">
      <list string="Tagging List" default_order="id desc" create="0" delete="0">
        <field name="create_date" string="Tanggal" />
        <field name="status" widget="badge" decoration-danger="status == 'open'" decoration-warning="status in ('validated','open_wo')" decoration-success="status == 'closed'" />
        <field name="name" string="Ticket" />
        <field name="plant_code" string="Plant" />
        <field name="system_id"/>
        <field name="sub_system_id" string="Sub System" />
        <field name="pic_name" string="PIC" />
        <field name="category_problem_id" string="Kategori Masalah" />
      </list>
    </field>
  </record>

  <!-- ===================== FORM VIEW ===================== -->
  <!-- INI YANG DIPAKE DAN DIBIKIN SAMA BAYU -->
  <record id="view_tagging_record_form" model="ir.ui.view">
    <field name="name">tagging.record.form</field>
    <field name="model">tagging.record</field>
    <field name="arch" type="xml">
      <form string="Tagging">
        <header>
          <field name="status" widget="statusbar" />
          <button name="action_validate" type="object" string="Validate" class="btn-primary" invisible="status != 'open'" />
          <button name="action_open_reject_wizard" type="object" string="Reject" class="btn-secondary" invisible="status != 'open'" />
          <button name="action_set_wo" type="object" string="Set Work Order" class="btn-secondary" invisible="status != 'validated'" />
          <button name="action_set_closed" type="object" string="Set Closed" class="btn-primary" invisible="status not in ('validated','open_wo')" />
        </header>
        <sheet readonly="status == 'closed'">
          <div class="oe_title">
            <h1>
              <field name="name" readonly="1" />
            </h1>
          </div>
          <group>
            <group string="Tagging Info">
              <field name="tagger_name" readonly="1"/>
              <field name="barcode_id" readonly="1" options="{'no_open': True, 'no_create': True}" />
              <!-- <field name="pic_department_names" readonly="1" /> -->
              <field name="department_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
              <field name="status" readonly="1" />
              <field name="maintenance_team_id" readonly="status not in ('validated','open_wo','closed')" invisible="1"/>
              <field name="start_date" readonly="1" />
              <field name="end_date" force_save="1" readonly="1" />
            </group>
            <group string="Location Snapshot">
              <field name="plant_code" readonly="1" />
              <field name="plant_name" readonly="1" />
              <field name="system_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
              <field name="sub_system_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
              <field name="sub_system_code" readonly="1" />
              <field name="functional_location" readonly="1" string="Functional Location (Legacy)" invisible="1"/>
            </group>
          </group>
          <group name="tag_categ" string="Category Problem">
            <field name="category_problem_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
          </group>
          <group name="tag_equipment" string="Equipment" invisible="status not in ('validated','open_wo','closed')">
            <field name="system_id" invisible="1" options="{'no_open': True, 'no_create': True}"/>
            <field name="sub_system_id" invisible="1" options="{'no_open': True, 'no_create': True}"/>
            <field name="functional_location" invisible="1" />
            <field name="parent_equipment_id" options="{'no_create': True, 'no_create_edit': True}" />
            <field name="equipment_id" options="{'no_create': True, 'no_create_edit': True}" readonly="not parent_equipment_id" />
          </group>
          <group name="wo_spareparts" string="WO Spareparts" invisible="status not in ('open_wo','closed')">
            <field name="wo_sparepart_ids" readonly="status == 'closed'">
              <list editable="bottom">
                <field name="spare_part_id" context="{'display_name_only': 1}" options="{'no_create': True, 'no_create_edit': True}" />
                <field name="sku" readonly="1" />
                <field name="specification" readonly="1" />
                <field name="qty" string="Jumlah" />
                <field name="remarks" readonly="1" />
              </list>
            </field>
          </group>
          <group>
              <group name="tag_desc" string="Description">
                <field name="attachment_ids" widget="many2many_binary" options="{'no_create': False, 'no_open': True}" class="tagging_gallery" readonly="status != 'open'"/>
                <field name="description" readonly="status != 'open'"/>
              </group>
              <group string="Close Evidence" invisible="status not in ('validated','open_wo','closed')">
                <field name="close_start_date" string="Work Start Date" readonly="status == 'closed'"/>
                <field name="close_end_date" string="Work End Date"/>
                <field name="close_description" readonly="status == 'closed'"/>
                <field name="close_photo" widget="image" filename="close_photo_filename" readonly="status == 'closed'"/>
                <field name="close_photo_filename" invisible="1"/>
              </group>
          </group>
          <!-- <notebook>
            <page string="Description" readonly="1">
              <field name="description" readonly="status != 'open'" />
            </page>
            <page string="Photos" readonly="1">
              <group col="2">
                <group string="Photos Tagging" readonly="1">
                  <field name="attachment_ids" widget="many2many_binary" options="{'no_create': False, 'no_open': True}" class="tagging_gallery" readonly="status != 'open'" />
                </group>
                <group string="Close Evidence" invisible="status not in ('validated','open_wo','closed')">
                  <field name="close_start_date" string="Work Start Date" readonly="status == 'closed'" />
                  <field name="close_end_date" string="Work End Date"/>
                  <field name="close_description" readonly="status == 'closed'" />
                  <field name="close_photo" widget="image" filename="close_photo_filename" readonly="status == 'closed'" />
                  <field name="close_photo_filename" invisible="1" />
                </group>
              </group>
            </page>
            <page string="Reject Reason" invisible="not reject_reason" readonly="1">
              <field name="reject_reason" readonly="1" nolabel="1" />
            </page>
          </notebook> -->
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===================== GRAPH VIEW ===================== -->
  <record id="view_tagging_record_graph" model="ir.ui.view">
    <field name="name">tagging.record.graph</field>
    <field name="model">tagging.record</field>
    <field name="arch" type="xml">
      <graph string="Tagging Statistics" type="bar">
        <field name="status" type="row" />
        <field name="id" type="measure" />
      </graph>
    </field>
  </record>

  <!-- ===================== REJECT WIZARD VIEW ===================== -->
  <record id="view_tagging_reject_wizard_form" model="ir.ui.view">
    <field name="name">tagging.record.reject.wizard.form</field>
    <field name="model">tagging.record.reject.wizard</field>
    <field name="arch" type="xml">
      <form string="Reject Tagging">
        <group>
          <field name="record_id" invisible="1" />
          <field name="reason" placeholder="Tuliskan alasan reject..." />
        </group>
        <footer>
          <button name="action_confirm_reject" type="object" string="Reject" class="btn-primary" />
          <button string="Cancel" special="cancel" class="btn-secondary" />
        </footer>
      </form>
    </field>
  </record>

  <!-- ===================== ACTION ===================== -->
  <record id="action_tagging_records" model="ir.actions.act_window">
    <field name="name">Tagging List</field>
    <field name="res_model">tagging.record</field>
    <field name="view_mode">list,form,graph</field>
    <field name="view_id" ref="view_tagging_record_list" />
    <field name="search_view_id" ref="view_tagging_record_search" />
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Buat data tagging pertama.</p>
    </field>
  </record>

