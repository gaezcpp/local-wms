<odoo>

  <!-- ===================== SEARCH VIEW ===================== -->
  <record id="view_tagging_record_search" model="ir.ui.view">
    <field name="name">tagging.record.search</field>
    <field name="model">tagging.record</field>
    <field name="arch" type="xml">
      <search string="Search Tagging">
        <field name="name" />
        <!-- <field name="plant_code" /> -->
        <field name="company_id" />
        <!-- <field name="pic_department_names" /> -->
        <field name="department_id" />
        <field name="category_problem_id" />
        <field name="status" />
        <separator />
        <filter string="Open" name="flt_open" domain="['|',('status','=','open'),('status','=','open_wo')]" />
        <filter string="Validated" name="flt_validated" domain="[('status','=','validated')]" />
        <filter string="Closed" name="flt_closed" domain="[('status','=','closed')]" />
        <separator />
        <field name="active" invisible="1" />
        <filter string="Archived" name="archived" domain="[('active','=',False)]" />
        <filter string="Active" name="active_only" domain="[('active','=',True)]" context="{'search_default_active_only': 1}" />
        <separator />
        <filter string="Group by Status" name="grp_status" context="{'group_by': 'status'}" />
        <filter string="Group by Company" name="grp_plant" context="{'group_by': 'company_id'}" />
      </search>
    </field>
  </record>

  <record id="view_tagging_record_list" model="ir.ui.view">
    <field name="name">tagging.record.list</field>
    <field name="model">tagging.record</field>
    <field name="arch" type="xml">
      <list string="Tagging List" default_order="id desc" create="0" delete="0">
        <field name="start_date" string="Tanggal" />
        <field name="status" widget="badge" decoration-danger="status == 'open'" decoration-warning="status in ('validated','open_wo')" decoration-success="status == 'closed'" />
        <field name="name" string="Ticket" />
        <!-- <field name="plant_code" string="Plant" /> -->
        <field name="company_id"/>
        <field name="system_id"/>
        <field name="sub_system_id" string="Sub System" />
        <field name="department_id" string="PIC" />
        <field name="category_problem_id" string="Kategori Masalah" />
      </list>
    </field>
  </record>

  <!-- ===================== FORM VIEW ===================== -->
  <!-- INI YANG DIPAKE DAN DIBIKIN SAMA BAYU -->
  <record id="view_tagging_record_form" model="ir.ui.view">
    <field name="name">tagging.record.form</field>
    <field name="model">tagging.record</field>
    <field name="arch" type="xml">
      <form string="Tagging">
        <header>
          <field name="status" widget="statusbar" />
          <button name="action_validate" type="object" string="Validate" class="btn-primary" invisible="status != 'open'" confirm="Are you sure that everything is already correct?"/>
          <button name="action_open_reject_wizard" type="object" string="Reject" class="btn-secondary" invisible="status != 'open'" />
          <!-- <button name="action_set_wo" type="object" string="Set Spare Part" class="btn-success" invisible="is_locked or status != 'validated'" /> -->
          <button name="action_set_open_wo" type="object" string="Set Open-WO" class="btn-info" invisible="is_locked or status not in ('validated')" confirm="Are you sure that everything is already correct?"/>
          <button name="action_set_closed" type="object" string="Set Closed" class="btn-primary" invisible="status not in ('validated', 'open_wo')" confirm="Are you sure that everything is already correct?"/>
        </header>
        <sheet readonly="status == 'closed'">
          <div class="oe_title">
            <h1>
              <field name="name" readonly="1" />
            </h1>
          </div>
          <group>
            <group string="Tagging Info">
              <field name="tagger_name" readonly="1"/>
              <field name="barcode_id" readonly="1" options="{'no_open': True, 'no_create': True}" />
              <field name="department_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
              <field name="status" readonly="1" />
              <field name="maintenance_team_id" readonly="status not in ('validated','open_wo','closed')" invisible="1"/>
              <field name="start_date" readonly="1" />
              <field name="end_date" force_save="1" readonly="1" />
            </group>
            <group string="Location Snapshot">
              <field name="company_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
              <field name="system_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
              <field name="sub_system_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
              <field name="sub_system_code" readonly="1" />
              <field name="abc_indic" readonly="1" />
              <field name="functional_location" readonly="1" string="Functional Location (Legacy)" invisible="1"/>
            </group>
          </group>
          <group name="tag_categ" string="Category Problem">
            <field name="category_problem_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
          </group>
          <group name="reject_info" string="Reject Information" invisible="status != 'rejected'">
            <field name="reject_reason" readonly="1" invisible="status != 'rejected'"/>
          </group>
          <group name="tag_equipment" string="Equipment" invisible="status not in ('validated','open_wo','closed', 'waiting_sap', 'process_sap', 'open_wo', 'closed')">
            <field name="system_id" invisible="1" options="{'no_open': True, 'no_create': True}"/>
            <field name="sub_system_id" invisible="1" options="{'no_open': True, 'no_create': True}"/>
            <field name="functional_location" invisible="1" />
            <field name="parent_equipment_id" options="{'no_open': True, 'no_create': True}" readonly="status not in ('open', 'validated')"/>
            <field name="equipment_id" options="{'no_open': True, 'no_create': True}" readonly="not parent_equipment_id or status not in ('open', 'validated')" />
          </group>
          <br/>
          <button name="action_set_wo" type="object" string="Set Spare Part" class="btn-success" invisible="is_locked or status != 'validated'"/>
          <group name="wo_spareparts" string="WO Spareparts" invisible="status == 'open'">
            <field name="is_locked" readonly="1"/>
            <field name="wo_sparepart_ids" readonly="1">
              <list create="0" edit="0" delete="0" duplicate="0">
                <field name="spare_part_id" context="{'display_name_only': 1}" options="{'no_open': True, 'no_create': True}" />
                <field name="sku" readonly="1" />
                <field name="qty" string="Jumlah" />
                <field name="remarks" readonly="1" />
              </list>
              <form>
                <field name="spare_part_id" context="{'display_name_only': 1}" options="{'no_open': True, 'no_create': True}" />
              </form>
            </field>
          </group>
          <group>
              <!-- <group name="tag_desc" string="Description">
                <field name="attachment_ids" widget="many2many_binary" options="{'no_create': False, 'no_open': True}" class="tagging_gallery" readonly="1" create="0" edit="0" delete="0"/>
                <field name="description" readonly="1"/>
              </group> -->
              <!--PREVIEW IMAGE-->
              <group name="tag_desc" string="Description">
                  <field name="attachment_ids" class="tagging_gallery" readonly="1" mode="kanban">
                      <kanban>
                          <field name="id"/>
                          <field name="name"/>
                          <field name="mimetype"/>
                          <templates>
                              <t t-name="card">
                                  <div class="oe_kanban_global_click d-flex flex-column align-items-center justify-content-center" style="width: 120px; height: 140px; margin: 5px; border: 1px solid #ddd; border-radius: 5px;">
                                      
                                      <t t-if="record.mimetype.value.match('image.*')">
                                          <a t-attf-href="/web/image/ir.attachment/#{record.id.raw_value}/datas" target="_blank" title="Click to Preview">
                                              <img t-att-src="'/web/image/ir.attachment/' + record.id.raw_value + '/datas'" 
                                                  style="max-width: 100px; max-height: 100px; object-fit: contain; border-radius: 4px;" alt="Preview"/>
                                          </a>
                                      </t>
                                      
                                      <t t-else="">
                                          <a t-attf-href="/web/content/ir.attachment/#{record.id.raw_value}/datas?download=true" title="Download File">
                                              <span class="fa fa-4x fa-file-o text-muted"/>
                                          </a>
                                      </t>
                                      
                                      <div class="text-truncate w-100 text-center mt-2" t-att-title="record.name.value" style="font-size: 11px;">
                                          <field name="name"/>
                                      </div>
                                  </div>
                              </t>
                          </templates>
                      </kanban>
                      <form>
                        <field name="name" readonly="1"/>
                      </form>
                  </field>
                  
                  <field name="description" readonly="1"/>
              </group>
              <group string="Close Evidence" invisible="status not in ('validated', 'open_wo', 'closed')">
                  <field name="close_start_date" string="Work Start Date" readonly="status == 'closed'" />
                  <field name="close_end_date" string="Work End Date" readonly="status == 'closed'" />
                  <field name="close_description" placeholder="e.g Mesin sudah disesuaikan" readonly="status == 'closed'" />
                  <field name="close_reason" placeholder="e.g Sudah diperbaiki" readonly="status == 'closed'" />
                  <field name="close_photo" 
                        widget="image" 
                        filename="close_photo_filename" 
                        readonly="status == 'closed'"/>
                  <field name="close_photo_filename" invisible="1"/>
              </group>
          </group>
        </sheet>
      <chatter/>
      </form>
    </field>
  </record>

  <!-- ===================== GRAPH VIEW ===================== -->
  <record id="view_tagging_record_graph" model="ir.ui.view">
    <field name="name">tagging.record.graph</field>
    <field name="model">tagging.record</field>
    <field name="arch" type="xml">
      <graph string="Tagging Statistics" type="bar">
        <field name="status" type="row" />
        <field name="id" type="measure" />
      </graph>
    </field>
  </record>

  <!-- ===================== REJECT WIZARD VIEW ===================== -->
  <record id="view_tagging_reject_wizard_form" model="ir.ui.view">
    <field name="name">tagging.record.reject.wizard.form</field>
    <field name="model">tagging.record.reject.wizard</field>
    <field name="arch" type="xml">
      <form string="Reject Tagging">
        <group>
          <field name="record_id" invisible="1" />
          <field name="reason" placeholder="Tuliskan alasan reject..." />
        </group>
        <footer>
          <button name="action_confirm_reject" type="object" string="Reject" class="btn-primary" />
          <button string="Cancel" special="cancel" class="btn-secondary" />
        </footer>
      </form>
    </field>
  </record>

  <!-- ===================== ACTION ===================== -->
  <record id="action_tagging_records" model="ir.actions.act_window">
    <field name="name">Tagging List</field>
    <field name="res_model">tagging.record</field>
    <field name="view_mode">list,form,graph</field>
    <field name="view_id" ref="view_tagging_record_list" />
    <field name="search_view_id" ref="view_tagging_record_search" />
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Buat data tagging pertama.</p>
    </field>
  </record>

