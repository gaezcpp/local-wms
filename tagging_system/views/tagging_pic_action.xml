<odoo>
    <record id="tagging_pic_view_list" model="ir.ui.view">
        <field name="name">tagging.pic.view.list</field>
        <field name="model">tagging.pic</field>
        <field name="arch" type="xml">
            <list string="PIC List">
                <field name="email"/>
                <field name="cc"/>
            </list>
        </field>
    </record>
    <record id="tagging_pic_view_form" model="ir.ui.view">
        <field name="name">tagging.pic.view.form</field>
        <field name="model">tagging.pic</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="email"/>
                        <field name="cc"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_tagging_pic" model="ir.actions.act_window">
        <field name="name">PIC List</field>
        <field name="res_model">tagging.pic</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="tagging_department_view_list" model="ir.ui.view">
        <field name="name">tagging.department.view.list</field>
        <field name="model">tagging.department</field>
        <field name="arch" type="xml">
            <list string="">
                <field name="name"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>
    <record id="tagging_department_view_form" model="ir.ui.view">
        <field name="name">tagging.department.view.form</field>
        <field name="model">tagging.department</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="pic_list" string="PIC">
                            <field name="pic_ids">
								<list editable="bottom">
									<field name="department_id" options="{'no_open': True, 'no_create': True}" column_invisible="1" readonly="1"/>
                                    <field name="email"/>
                                    <field name="cc"/>
								</list>
								<form create="0" edit="0" delete="0">
                                    <group>
                                        <field name="department_id" options="{'no_open': True, 'no_create': True}" invisible="1" readonly="1"/>
                                        <field name="email" readonly="1"/>
                                        <field name="cc" readonly="1"/>
                                    </group>
								</form>
							</field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_tagging_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">tagging.department</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_tagging_bu" model="ir.actions.act_window">
        <field name="name">BUs</field>
        <field name="res_model">tagging.bu</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
