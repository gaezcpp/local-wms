<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="inherit_stock_picking_form_views">
            <field name="name">stock.picking.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_uom']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='quantity']" position="attributes">
                    <attribute name="force_save">1</attribute>
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='product_id']" position="after">
                    <!-- <field name="qty_packaging_sap" column_invisible="1"/> -->
                    <!-- <field name="product_packaging_id" domain="[('product_id', '=', product_id)]" options="{'no_create': True}" column_invisible="1"/> -->
                </xpath>
                <xpath expr="//field[@name='product_uom']" position="after">
                    <field name="bag_qty" string="Quantity" force_save="1" readonly="1" column_invisible="parent.state=='draft'" decoration-danger="product_uom_qty and quantity > product_uom_qty and parent.state not in ['done', 'cancel']"/>
                    <field name="uom_bag_id" string="Unit" force_save="1" readonly="1" column_invisible="parent.state=='draft'" options="{'no_open': True, 'no_create': True}" widget="many2one_uom" groups="uom.group_uom"/>

                    <field name="pallet_qty" string="Pallet" force_save="1" readonly="1" column_invisible="parent.state=='draft'" decoration-danger="product_uom_qty and quantity > product_uom_qty and parent.state not in ['done', 'cancel']"/>
                    <field name="uom_pallet_id" string="Unit" force_save="1" readonly="1" column_invisible="parent.state=='draft'" options="{'no_open': True, 'no_create': True}" widget="many2one_uom" groups="uom.group_uom"/>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="inherit_stock_barcode_picking_view_kanban">
            <field name="name">inherit.stock.barcode.picking.kanban</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock_barcode.stock_picking_view_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <div class="mt-2" t-if="record.detail_operation_scan.raw_value" style="flex-basis: 100%; text-align: left;">
                        <div>
                            <div class="fw-bold text-muted mb-1" style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px;">
                                <i class="fa fa-barcode me-1"/> Package Details
                            </div>
                            <div style="white-space: pre-wrap; font-size: 12px; line-height: 1.4;">
                                <field name="detail_operation_scan"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>