<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherit_stock_move_line_product_selector" model="ir.ui.view">
        <field name="name">inherit.stock.product.selector</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock_barcode.stock_move_line_product_selector"/>
        <field name="arch" type="xml">
            <!--GLOBAL-->
            <xpath expr="//field[@name='quant_id']" position="after">
                <field name="picking_type_id" invisible="1"/>
                <field name="mandatory_destination" invisible="1"/>
                <field name="dummy_full_pallet" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='qty_done']" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                <attribute name="force_save">1</attribute>
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='qty_done']" position="attributes">
                <attribute name="force_save">1</attribute>
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='product_uom_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='package_id']" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='outermost_result_package_id']" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                <attribute name="invisible">production_only or checker_only</attribute> <!--PRODUCTION ONLY-->
            </xpath>
            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
            </xpath>
            <xpath expr="//div[@name='properties']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!--GLOBAL-->

            <!--PRODUCTION ONLY-->
            <xpath expr="//div[@name='location_dest']" position="attributes">
                <attribute name="invisible">production_only</attribute>
            </xpath>
            <xpath expr="//div[@name='package']" position="attributes">
                <attribute name="invisible">production_only</attribute>
            </xpath>
            <xpath expr="//div[@name='outermost_package']" position="attributes">
                <attribute name="invisible">production_only or checker_only</attribute>
            </xpath>
            <xpath expr="//div[@name='tracking_number']" position="attributes">
                <attribute name="invisible">production_only</attribute>
            </xpath>
            <!-- <xpath expr="//field[@name='expiration_date']/parent::div/parent::div" position="attributes">
                <attribute name="invisible">not use_expiration_date or production_only</attribute>
            </xpath> -->
            <xpath expr="//field[@name='result_package_id']" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
                <attribute name="domain">
                    (company_id and [('company_id', 'in', [company_id] + [False])] or [('company_id', '=', False)]) + ['|', '|', ('location_id', '=', False), ('location_id', '=', location_dest_id), ('id', '=', package_id)] + [('can_be_use', '=', True)]
                </attribute>
            </xpath>
            <xpath expr="//field[@name='product_uom_id']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="class">fs-6</attribute>
            </xpath>
            <xpath expr="//label[@for='result_package_id']" position="attributes">
                <attribute name="string">Pallet</attribute>
            </xpath>
            <xpath expr="//div[@name='location_src']/field[@name='location_id']" position="attributes">
                <attribute name="readonly">checker_only</attribute>
            </xpath>
            <xpath expr="//field[@name='location_dest_id']" position="attributes">
                <attribute name="readonly">checker_only</attribute>
            </xpath>
            <xpath expr="//field[@name='package_id']" position="attributes">
                <attribute name="readonly">checker_only</attribute>
            </xpath>
            <xpath expr="//div[@name='quantity']" position="attributes">
                <attribute name="invisible">checker_only or checker_out</attribute>
            </xpath>
            <xpath expr="//div[@name='quantity']" position="before">
                <div name="bag_quantity" class="row my-2">
                    <div class="col">
                        <field name="bag_qty" class="text-end" options="{'type': 'number'}" force_save="1" placeholder="Bag Qty"/>
                    </div>
                    <div class="col-3 ps-0" groups="uom.group_uom">
                        <field name="uom_bag_id" class="fs-6" options="{'no_open': True, 'no_create': True}" groups="uom.group_uom" widget="many2one_uom" force_save="1"/>
                    </div>
                </div>
                <div name="pallet_quantity" class="row my-2" invisible="checker_only or checker_out">
                    <div class="col">
                        <field name="pallet_qty" class="text-end" options="{'type': 'number'}" placeholder="Pallet Qty" force_save="1" readonly="1"/>
                    </div>
                    <div class="col-3 ps-0" groups="uom.group_uom">
                        <field name="uom_pallet_id" class="fs-6" options="{'no_open': True, 'no_create': True}" groups="uom.group_uom" widget="many2one_uom" force_save="1"/>
                    </div>
                </div>
            </xpath>
            <!-- <xpath expr="//div[@name='quantity']" position="after">
                <div name="btn_full_pallet" class="row my-2" invisible="not production_only">
                    <div class="col text-end">
                        <field name="dummy_full_pallet" widget="full_pallet_button"/>
                    </div>
                </div>
            </xpath> -->
            <xpath expr="//div[@name='digipad']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='location_src']" position="before">
                <div name="production_text" class="row my-2" invisible="not production_only">
                    <div class="col-6">
                        <div class="text-black-50 mt-2 fs-5">
                            <span class="fa fa-map-marker me-1"/>
                            <label for="production_line_id" string="Production Line" class="p-0"/>
                        </div>
                        <field name="production_line_id" string="Production Line Packaging" class="w-100" 
                                placeholder="Production Line" 
                                options="{'no_open': True, 'no_create': True}" 
                                domain="[('company_id', '=', company_id)]"/>
                    </div>
                    <div class="col-6">
                        <div class="text-black-50 mt-2 fs-5">
                            <span class="fa fa-map-marker me-1"/>
                            <label for="detail_text" string="Detail Text" class="p-0"/>
                        </div>
                        <field name="detail_text" placeholder="Detail Text" class="w-100"/>
                    </div>
                </div>
                <!-- <div name="first_last_count" class="row my-2" invisible="not production_only">
                    <div class="col-6">
                        <div class="text-black-50 mt-2 fs-5">
                            <span class="fa fa-map-marker me-1"/>
                            <label for="first_count" string="First Count" class="p-0"/>
                        </div>
                        <field name="first_count" placeholder="First Count"/>
                    </div>
                    <div class="col-6">
                        <div class="text-black-50 mt-2 fs-5">
                            <span class="fa fa-map-marker me-1"/>
                            <label for="last_count" string="Last Count" class="p-0"/>
                        </div>
                        <field name="last_count" placeholder="Last Count"/>
                    </div>
                </div> -->
                <div name="qty_packaging_sap" class="row" invisible="1">
                    <div  class="text-black-50 mt-2 fs-5">
                        <span class="fa fa-archive me-1"/>
                        <label for="qty_packaging_sap" string="Qty Packaging SAP" class="p-0"/>
                    </div>
                    <field name="qty_packaging_sap" placeholder="Qty Packaging SAP"/>
                </div>
            </xpath>
            <!-- <xpath expr="//field[@name='result_package_id']" position="after">
                <div name="pallet_ke" class="row" invisible="not production_only">
                    <div  class="text-black-50 mt-2 fs-5">
                        <span class="fa fa-archive me-1"/>
                        <label for="pallet_ke" string="Pallet Ke-" class="p-0"/>
                    </div>
                    <field name="pallet_ke" placeholder="Pallet Ke-" readonly="1"/>
                </div>
            </xpath> -->
        </field>
    </record>
</odoo>