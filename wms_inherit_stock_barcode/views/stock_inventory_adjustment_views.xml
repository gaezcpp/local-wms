<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="stock_inventory_adjustment_search">
        <field name="name">stock.inventory.adjustment.search</field>
        <field name="model">stock.inventory.adjustment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="pid_sap"/>
                <field name="company_id"/>
                <filter name="fl_draft" string="Draft" domain="[('state','=', 'draft')]"/>
                <filter name="fl_in_progress" string="In Progress" domain="[('state','=', 'in_progress')]"/>
            </search>
        </field>
    </record>

    <record id="stock_inventory_adjustment_view_list" model="ir.ui.view">
        <field name="name">stock.inventory.adjustment.view.list</field>
        <field name="model">stock.inventory.adjustment</field>
        <field name="arch" type="xml">
            <list string="Inventory Adjustment">
                <field name="name"/>
                <field name="pid_sap"/>
                <field name="location_id"/>
                <field name="date_time"/>
                <field name="company_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="stock_inventory_adjustment_view_form" model="ir.ui.view">
        <field name="name">stock.inventory.adjustment.view.form</field>
        <field name="model">stock.inventory.adjustment</field>
        <field name="arch" type="xml">
            <form string="Inventory Adjustment">
                <field name="is_checked" invisible="1"/>
                <field name="need_berita_acara" invisible="1"/>
                <header>
                    <button name="check_details" string="Get Details" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_in_progress" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft' or not is_checked"/>
                    <button name="action_done_counting" string="Done Counting" type="object" class="btn btn-success" invisible="state != 'in_progress'" confirm="Are you sure?"/>
                    <button name="action_cancelled" string="Cancel" type="object" class="btn btn-danger" invisible="state != 'in_progress'" confirm="Are you sure?"/>
                    <button name="action_berita_acara" string="Buat Berita Acara" type="object" class="oe_highlight" invisible="state != 'done_sap' or not need_berita_acara"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done_counting,done_sap,berita_acara"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_quant" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="quant_count" widget="statinfo" string="Quant"/>
                        </button>
                        <button name="action_open_kanban_barcode" type="object" class="oe_stat_button" icon="fa-barcode" string="Barcode"/>
                    </div>
                    <h1>
                        <field name="name" placeholder="e.g Inventory Adjustment" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="pid_sap" readonly="1"/>
                            <field name="location_id" readonly="1" options="{'no_open': True, 'no_create': True}" domain="[('usage', '=', 'internal')]"/>
                            <field name="done_pid_number" invisible="done_pid_number != True" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_time" readonly="1"/>
                            <field name="company_id" options="{'no_open': True, 'no_create': True}" required="1" readonly="1"/>
                        </group>
                        <separator string="Notes"/>
                        <field name="notes" readonly="state != 'draft'" required="state == 'draft'" placeholder="Harus Opname . . ."/>
                    </group>
                    <notebook>
                        <page name="sia_details" string="Details">
                            <field name="adjustment_line_ids">
                                <list editable="bottom" create="0" edit="0" delete="0" duplicate="0">
                                    <field name="stock_adjustment_id" column_invisible="1"/>
                                    <field name="quant_id" column_invisible="1"/>
                                    <field name="product_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="location_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="lot_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="package_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="package_status"/>
                                    <field name="quantity" sum="total_qty"/>
                                    <field name="inventory_quantity" sum="total_inv_qty"/>
                                    <field name="uom_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="bag_qty" sum="total_bag"/>
                                    <field name="bag_count" sum="total_bag_count"/>
                                    <field name="uom_bag_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="inventory_diff_quantity" sum="total_diff_qty" decoration-muted="inventory_diff_quantity == 0" decoration-danger="inventory_diff_quantity &lt; 0" decoration-success="inventory_diff_quantity &gt; 0" decoration-bf="inventory_diff_quantity != 0"/>
								</list>
								<form create="0" edit="0" delete="0">
                                    <group>
                                        <field name="stock_adjustment_id" column_invisible="1"/>
                                        <field name="product_id" options="{'no_open': True, 'no_create': True}"/>
                                        <field name="location_id" options="{'no_open': True, 'no_create': True}"/>
                                        <field name="lot_id" options="{'no_open': True, 'no_create': True}"/>
                                        <field name="package_id" options="{'no_open': True, 'no_create': True}"/>
                                        <field name="quantity"/>
                                        <field name="inventory_quantity"/>
                                        <field name="inventory_diff_quantity"/>
                                    </group>
								</form>
                            </field>
                        </page>
                        <page name="sia_summary" string="Summary">
                            <field name="summary_line_ids">
                                <list create="0" edit="0" delete="0" duplicate="0">
                                    <field name="stock_adjustment_id" column_invisible="1"/>
                                    <field name="zeili"/>
                                    <field name="product_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="sloc_name"/>
                                    <field name="stock_type"/>
                                    <field name="quantity" sum="total_qty"/>
                                    <field name="inventory_quantity" sum="total_inv_qty"/>
                                    <field name="uom_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="bag_qty" sum="total_bag"/>
                                    <field name="bag_count" sum="total_bag_count"/>
                                    <field name="uom_bag_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="inventory_diff_quantity" sum="total_diff_qty" decoration-muted="inventory_diff_quantity == 0" decoration-danger="inventory_diff_quantity &lt; 0" decoration-success="inventory_diff_quantity &gt; 0" decoration-bf="inventory_diff_quantity != 0"/>
								</list>
								<form create="0" edit="0" delete="0">
                                    <group>
                                        <field name="stock_adjustment_id" column_invisible="1"/>
                                        <field name="product_id" options="{'no_open': True, 'no_create': True}"/>
                                        <field name="sloc_name"/>
                                        <field name="stock_type"/>
                                        <field name="quantity"/>
                                        <field name="inventory_quantity"/>
                                        <field name="inventory_diff_quantity"/>
                                    </group>
								</form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="stock_inventory_adjustment_view_kanban" model="ir.ui.view">
        <field name="name">stock.inventory.adjustment.view.kanban</field>
        <field name="model">stock.inventory.adjustment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="0" group_create="false">
                <field name="name"/>
                <field name="location_id"/>
                <field name="date_time"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record p-3 position-relative">
                            <a type="object" name="action_open_barcode_inventory" class="stretched-link"/>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="fw-bold text-uppercase fs-6">
                                    <field name="name"/>
                                </div>
                                <div class="text-muted small">
                                    <field name="date_time"/>
                                </div>
                            </div>
                            <div class="mb-1">
                                <span class="text-muted small">Location</span><br/>
                                <span class="fw-semibold">
                                    <field name="location_id"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="stock_inventory_adjustment_action" model="ir.actions.act_window">
        <field name="name">Inventory Adjustment (PID)</field>
        <field name="res_model">stock.inventory.adjustment</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="stock_inventory_adjustment_action_kanban_validated" model="ir.actions.act_window">
        <field name="name">Inventory Adjustment (PID)</field>
        <field name="res_model">stock.inventory.adjustment</field>
        <field name="view_mode">kanban</field>
        <field name="domain">[('state','=','in_progress')]</field>
    </record>
</odoo>