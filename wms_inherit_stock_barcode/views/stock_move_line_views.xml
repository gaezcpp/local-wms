<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="inherit_stock_move_line_operation_tree_views">
            <field name="name">inherit.stock.move.line.tree</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_uom_id']" position="after">
                    <field name="bag_qty" string="Quantity" force_save="1" readonly="1"/>
                    <field name="uom_bag_id" string="Unit" force_save="1" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                    <field name="wh_category_id" string="Category" force_save="1" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                    <field name="suggest_dest_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                </xpath>
                <xpath expr="//field[@name='quant_id']" position="before">
                    <field name="qty_packaging_sap" readonly="1" column_invisible="1"/>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="inherit_view_move_line_form">
            <field name="name">inherit.view.move.line.form</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//label[@for='quantity']" position="after">
                    <label for="bag_qty" string="Pack Qty"/>
                    <div class="o_row">
                        <field name="bag_qty"/>
                        <field name="uom_bag_id" options="{'no_open': True, 'no_create': True}" widget="many2one_uom" groups="uom.group_uom"/>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>