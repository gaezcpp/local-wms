<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="inherit_stock_lot_form_views">
            <field name="name">inherit.stock.lot.form</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_uom_id']" position="after">
                    <field name="bag_qty" string="Bag" force_save="1" readonly="1"/>
                    <field name="uom_bag_id" string="Unit" force_save="1" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>