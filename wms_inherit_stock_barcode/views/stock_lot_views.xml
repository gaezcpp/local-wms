<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="inherit_stock_lot_form_views">
            <field name="name">inherit.stock.lot.form</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location_id']" position="after">
                    <label for="bag_qty" invisible="not display_complete"/>
                    <div invisible="not display_complete">
                        <field name="bag_qty" class="oe_inline me-1" readonly="1"/>
                        <field name="uom_bag_id" groups="uom.group_uom" widget="many2one_uom" options="{'no_open': True, 'no_create': True}" class="oe_inline" readonly="1"/>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>