<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="inherit_view_move_kanban">
            <field name="name">inherit.stock.move.operations.kanban</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_move_kandan"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_uom']" position="after">
                    <br/>Pack Qty
                    <field name="bag_qty" readonly="state != 'draft'"/>
                    <field name="uom_bag_id" options="{'no_open': True, 'no_create': True}" groups="uom.group_uom" class="ms-1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>