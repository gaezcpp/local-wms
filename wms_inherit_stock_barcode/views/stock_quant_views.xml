<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="inherit_stock_quant_tree_editable_views">
            <field name="name">inherit.stock.quant.tree</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_uom_id']" position="after">
                    <field name="bag_qty" string="Bag" force_save="1" readonly="1"/>
                    <field name="uom_bag_id" string="" force_save="1" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                </xpath>
            </field>
        </record>

        <record id="inherit_stock_quant_barcode" model="ir.ui.view">
            <field name="name">inherit.stock.quant.barcode</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock_barcode.stock_quant_barcode"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="inbound_date" invisible="1"/>
                    <field name="exp_group" invisible="1"/>
                    <field name="bag_qty" invisible="1"/>
                    <field name="pallet_qty" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='inventory_quantity']" position="attributes">
                    <attribute name="force_save">1</attribute>
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='product_uom_id']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//div[@name='quantity']" position="before">
                    <div name="bag_quantity" class="row my-2">
                        <div class="col">
                            <field name="bag_dummy_qty" class="text-end" options="{'type': 'number'}" force_save="1" placeholder="Bag Qty"/>
                        </div>
                        <div class="col-3 ps-0" groups="uom.group_uom">
                            <field name="uom_bag_id" options="{'no_open': True}" groups="uom.group_uom" widget="many2one_uom" force_save="1" readonly="1"/>
                        </div>
                    </div>
                    <div name="pallet_quantity" class="row my-2">
                        <div class="col">
                            <field name="pallet_dummy_qty" class="text-end" options="{'type': 'number'}" placeholder="Pallet Qty" force_save="1" readonly="1"/>
                        </div>
                        <div class="col-3 ps-0" groups="uom.group_uom">
                            <field name="uom_pallet_id" options="{'no_open': True}" groups="uom.group_uom" widget="many2one_uom" force_save="1" readonly="1"/>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>