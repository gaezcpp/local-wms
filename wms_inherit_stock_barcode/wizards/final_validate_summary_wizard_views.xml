<odoo>
    <record id="view_final_validate_summary_wizard_form" model="ir.ui.view">
        <field name="name">final.validate.summary.wizard.form</field>
        <field name="model">final.validate.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Konfirmasi Validate Final">
                <group>
                    <field name="message" widget="text" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Validate" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
