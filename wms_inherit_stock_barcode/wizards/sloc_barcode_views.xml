<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_sloc_packaging_wizard_form" model="ir.ui.view">
        <field name="name">sloc.barcode.form</field>
        <field name="model">sloc.barcode</field>
        <field name="arch" type="xml">
            <form string="Set SLOC Packaging">
                <group>
                    <field name="sloc_id" required="1" options="{'no_open': True, 'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary" confirm="Yakin SLOC Sudah sesuai?"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>