<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_create_new_picking_wizard_form" model="ir.ui.view">
        <field name="name">create.new.picking.form.wizard</field>
        <field name="model">create.new.picking</field>
        <field name="arch" type="xml">
            <form string="QQ">
                <group>
                    <field name="picking_id" options="{'no_open': True, 'no_create': True}" force_save="1" readonly="1"/>
                </group>
                <separator string="Lines"/>
                <field name="line_ids">
                    <list editable="bottom" create="0">
                        <field name="create_new_picking_id" options="{'no_open': True, 'no_create': True}" column_invisible="1" readonly="1"/>
                        <field name="product_id" options="{'no_open': True, 'no_create': True}" force_save="1" readonly="1"/>
                        <field name="qty" force_save="1" readonly="1" optional="hide"/>
                        <field name="product_uom_id" options="{'no_open': True, 'no_create': True}" widget="many2one_uom" force_save="1" readonly="1" optional="hide"/>
                        <field name="qty_pack" />
                        <field name="pack_uom_id" options="{'no_open': True, 'no_create': True}" widget="many2one_uom" force_save="1" readonly="1" />
                        <field name="company_id" options="{'no_open': True, 'no_create': True}" force_save="1" readonly="1" optional="hide"/>
                    </list>
                    <form create="0" edit="0" delete="0">
                        <group>
                            <field name="create_new_picking_id" options="{'no_open': True, 'no_create': True}" invisible="1" readonly="1"/>
                            <field name="product_id" options="{'no_open': True, 'no_create': True}" readonly="1"/>
                            <field name="qty" readonly="1"/>
                            <field name="product_uom_id" options="{'no_open': True, 'no_create': True}" readonly="1"/>
                        </group>
                    </form>
                </field>
                <footer>
                    <button name="create_new_picking_from_wizard" type="object" string="Confirm" class="btn-primary" confirm="Yakin semua data sudah sesuai?"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_quality_quantity_backorder_kanban" model="ir.ui.view">
        <field name="name">create.new.picking.kanban</field>
        <field name="model">create.new.picking.line</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="0" edit="1" delete="0">
                <field name="product_id"/>
                <field name="qty"/>
                <field name="qty_pack"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="row mb-2">
                                <div class="col-12">
                                    <strong><field name="product_id"/></strong>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6 text-muted">
                                    Qty: <field name="qty"/> <field name="product_uom_id"/>
                                </div>
                                <!-- <div class="col-6 text-right">
                                    <strong>Pack Qty: <field name="qty_pack"/></strong>
                                </div> -->
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>