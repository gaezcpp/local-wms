<templates xml:space="preserve">
    <t t-inherit="stock_barcode.MainComponent" t-inherit-mode="extension">
        <xpath expr="//footer" position="inside">
            <button t-if="env.model.isCheckerOnly() or env.model.isCheckerOut()"
                    t-on-click="env.model.openQualityBackorder"
                    class="btn btn-secondary">
                Quality Backorder
            </button>
            <!--QUANTITY PINDAH KE VALIDATE-->
            <button t-if="env.model.isCheckerOnly() or env.model.isCheckerOut()"
                    t-on-click="env.model.openQuantityBackorder"
                    class="btn btn-danger" confirm="Yakin ingin melakukan Check Quantity?">
                Check Quantity
            </button>
            <button t-if="env.model.isCreateNewPicking()"
                    t-on-click="env.model.createNewPicking"
                    class="btn btn-secondary">
                New Pick
            </button>
        </xpath>
        <!--PEMBATASAN USER-->
        <!--HIDE BUTTON SCANNER-->
        <!-- <xpath expr="//button[hasclass('o_add_line')]" position="attributes">
            <attribute name="t-if">env.model.displayAddProductButton and !env.model.isProductionOnly()</attribute>
            <attribute name="t-if">false</attribute>
        </xpath> -->
        <xpath expr="//button[hasclass('o_put_in_pack')]" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
    </t>
</templates>