    <t t-inherit="stock_barcode.LineLowerButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('gap-2')]" position="replace">
            <div t-else="" class="d-flex flex-nowrap gap-2">
                <button t-if="env.model.isProductionOnly()" name="deleteButton"
                        t-on-click="() => this.env.model.deleteLine(line)"
                        t-att-disabled="!this.env.model.lineCanBeEdited(line)"
                        class="o_line_button o_delete_line btn btn-danger">
                    <span class="fa fa-lg fa-trash"/>
                </button>
            </div>
        </xpath>
        <xpath expr="//div[@t-if='displayToggleBtn']" position="attributes">
            <attribute name="class">d-flex flex-column align-items-end</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o_toggle_sublines')]" position="before">
            <button t-if="showBulkEntryButton"
                    class="btn btn-sm btn-success o_btn_bulk_entry py-0 px-2 fs-7 mb-1"
                    t-on-click.stop="() => this.openBulkEntry(line)">
                <i class="fa fa-lg fa-pencil" role="img"/>
            </button>
        </xpath>
    </t>

    <!-- Saat bypass_entire_packs, baris grup dikelompokkan per product + package
         (lihat groupKey di barcode_pickimg_model_patch.js), jadi pallet asal pasti
         seragam untuk seluruh subline. Tampilkan pallet asal → pallet tujuan di
         header grup, tepat di bawah lokasi tujuan. Markup disamakan dengan blok
         name="package" milik stock_barcode.LineComponent. -->
    <t t-inherit="stock_barcode.GroupedLineComponent" t-inherit-mode="extension">
        <xpath expr="//t[@t-call='stock_barcode.LineDestinationLocation']" position="after">
            <div name="package"
                 t-if="env.model.record.picking_type_bypass_entire_packs and (line.package_id or line.result_package_id)">
                <i class="fa fa-fw fa-archive"/>
                <span t-if="line.package_id" class="package" t-esc="packageLabel"/>
                <i t-if="displayResultPackage" class="fa fa-long-arrow-right mx-1"/>
                <span t-if="line.result_package_id" class="result-package" t-esc="resultPackageLabel"/>
            </div>
        </xpath>
    </t>

