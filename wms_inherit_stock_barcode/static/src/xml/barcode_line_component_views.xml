<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="stock_barcode.LineQuantity" t-inherit-mode="extension">
        <xpath expr="//div[@name='quantity']" position="replace">
            <div name="quantity">
                <span class="o_packaging text-muted" t-if="line.packaging_uom_id &amp;&amp; line.packaging_uom_id.id !== line.product_uom_id.id">
                    Packaging: <span t-esc="line.packaging_uom_qty"/> <span t-esc="line.packaging_uom_id.name"/>
                </span>
                <br/>
                <t t-if="line.uom_bag_id">
                    <span class="o_barcode_scanner_qty font-monospace fs-1">
                        <span class="qty-done text-dark" t-esc="line.bag_qty ? Math.round(line.bag_qty * 100) / 100 : 0"/>
                    </span>
                    <small class="text-muted ms-1 fs-6">Bag</small>
                </t>
            </div>
        </xpath>
    </t>

    <!--NGILANGIN TOMBOL PLUS MINUS QUANTITY-->
    <!-- <t t-inherit="stock_barcode.LineLowerButtons" t-inherit-mode="extension">
        <xpath expr="//div[not(@t-if)]" position="replace">
            <div class="d-none flex-nowrap gap-2">
                </div>
        </xpath>
    </t> -->
    <t t-inherit="stock_barcode.LineLowerButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('gap-2')]" position="replace">
            <div t-else="" class="d-flex flex-nowrap gap-2">
                <button t-if="env.model.isProductionOnly()" name="deleteButton"
                        t-on-click="() => this.env.model.deleteLine(line)"
                        t-att-disabled="!this.env.model.lineCanBeEdited(line)"
                        class="o_line_button o_delete_line btn btn-danger">
                    <span class="fa fa-lg fa-trash"/>
                </button>
            </div>
        </xpath>
    </t>

    <t t-inherit="stock_barcode.PackageLineComponent" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='unpack']" position="attributes">
            <attribute name="t-if">!env.model.record.picking_type_bypass_entire_packs</attribute>
        </xpath>
        <xpath expr="//button[@t-on-click='openPackage']" position="attributes">
            <attribute name="t-if">!env.model.record.picking_type_bypass_entire_packs</attribute>
        </xpath>
        <xpath expr="//button[@t-on-click='unpack']" position="before">
            <t t-foreach="sublinesToDisplay" t-as="subline" t-key="subline.virtual_id">
                <button class="o_line_button o_edit btn btn-secondary"
                        t-on-click="(ev) => this.editSublineQty(subline, ev)"
                        t-att-disabled="!this.env.model.lineCanBeEdited(subline)">
                    <i class="fa fa-pencil" role="img"/>
                </button>
            </t>
        </xpath>

