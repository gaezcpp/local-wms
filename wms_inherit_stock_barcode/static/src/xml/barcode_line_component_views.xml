    <t t-inherit="stock_barcode.LineQuantity" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('o_packaging')]" position="replace">
            <span class="o_packaging text-muted" t-if="packagingLabel" t-esc="packagingLabel"/>
        </xpath>
        <xpath expr="//span[hasclass('qty-done')]" position="attributes">
            <attribute name="t-out">hasBagUom ? computedBagQty + ' ' + bagUomLabel : (hasPackUom ? packQtyLabel : (env.model.IsNotSet(line) ? '?' : qtyDone))</attribute>
        </xpath>
        <xpath expr="//span[hasclass('qty-done')]/../span[@t-if]" position="attributes">
            <attribute name="t-if">!(env.model.isCheckerOnly() or env.model.isCheckerOut()) and env.model.displayLineQtyDemand(line) and !hasPackUom</attribute>
        </xpath>
        <xpath expr="//span[hasclass('qty-done')]/../span[@t-if]" position="attributes">
            <attribute name="t-out">!(env.model.isCheckerOnly() or env.model.isCheckerOut()) ? (hasBagUom ? '/' + computedBagDemand + ' ' + bagUomLabel : '/' + qtyDemand) : ''</attribute>
        </xpath>
        <xpath expr="//small[hasclass('o_line_uom')]" position="attributes">
            <attribute name="t-if">props.displayUOM and !hasBagUom and !hasPackUom</attribute>
        </xpath>
    </t>

    <t t-inherit="stock_barcode.LineUpperButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_edit')]" position="attributes">
            <attribute name="t-if">!displayToggleBtn and !env.model.record.hide_edit_barcode</attribute>
        </xpath>
    </t>

    <t t-inherit="stock_barcode.LineLot" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_edit')]" position="attributes">
            <attribute name="t-if">!displayToggleBtn and !env.model.record.hide_edit_barcode</attribute>
        </xpath>
    </t>

    <!--NGILANGIN TOMBOL PLUS MINUS QUANTITY-->
    <!-- <t t-inherit="stock_barcode.LineLowerButtons" t-inherit-mode="extension">
        <xpath expr="//div[not(@t-if)]" position="replace">
            <div class="d-none flex-nowrap gap-2">
                </div>
        </xpath>
