<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="stock_barcode.LineQuantity" t-inherit-mode="extension">
        <xpath expr="//div[@name='quantity']" position="replace">
            <div name="quantity">
                <span class="o_packaging text-muted" t-if="line.packaging_uom_id &amp;&amp; line.packaging_uom_id.id !== line.product_uom_id.id">
                    Packaging: <span t-esc="line.packaging_uom_qty"/> <span t-esc="line.packaging_uom_id.name"/>
                </span>
                <br/>
                
                <!-- <t t-if="!line.checker_only or !line.checker_out">
                    <span t-attf-class="o_barcode_scanner_qty font-monospace fs-1">
                        <span class="qty-done"
                            t-attf-class="{{nextExpected === 'quantity' &amp;&amp; qtyDone ? 'o_flash' : ''}} {{qtyDemand &amp;&amp; qtyDone == 0 ? env.model.zeroQtyClass(line) : ''}} {{qtyDemand &amp;&amp; qtyDone &amp;&amp; qtyDone == qtyDemand ? 'text-success' : ''}}"
                            t-out="env.model.IsNotSet(line) ? '?' : qtyDone"/>
                        <span t-if="env.model.displayLineQtyDemand(line)" t-out="'/' + qtyDemand"/>
                    </span>
                    <small t-if="props.displayUOM" class="o_line_uom text-muted ms-1" t-out="props.line.product_uom_id.name"/>
                </t> -->

                <t t-if="line.uom_bag_id">
                    <!-- <span t-if="!line.checker_only or !line.checker_out" class="text-muted mx-2 fs-3 align-baseline">|</span> -->
                    <span class="o_barcode_scanner_qty font-monospace fs-1">
                        <span class="qty-done text-dark" t-esc="line.bag_qty ? Math.round(line.bag_qty * 100) / 100 : 0"/>
                    </span>
                    <small class="text-muted ms-1 fs-6">Bag</small>
                </t>

                <!-- <t t-if="line.uom_pallet_id">
                    <span class="text-muted mx-2 fs-3 align-baseline">|</span>
                    <span class="o_barcode_scanner_qty font-monospace fs-1">
                        <span class="qty-done text-dark" t-esc="line.pallet_qty ? Math.round(line.pallet_qty * 100) / 100 : 0"/>
                    </span>
                    <small class="text-muted ms-1 fs-6">Pallet</small>
                </t> -->
            </div>
        </xpath>
    </t>

    <!--NGILANGIN TOMBOL PLUS MINUS QUANTITY-->
    <t t-inherit="stock_barcode.LineLowerButtons" t-inherit-mode="extension">
        <xpath expr="//div[not(@t-if)]" position="replace">
            <div class="d-none flex-nowrap gap-2">
                </div>
        </xpath>
    </t>

    <t t-inherit="stock_barcode.LineDestinationLocation" t-inherit-mode="extension">
        <xpath expr="//div[@name='destination_location']" position="after">
            <div name="duplicate_button" class="mt-1">
                <!-- <button class="btn btn-sm btn-outline-secondary o_btn_duplicate_line py-0 px-2 fs-7"
                        t-on-click.stop="() => this.duplicateProductLine(line)">
                    <i class="fa fa-copy me-1"/> Duplicate Product
                </button> -->
            </div>
        </xpath>
    </t>
</templates>