    <t t-inherit="stock_barcode.MainComponent" t-inherit-mode="extension">
        <xpath expr="//PackageLineComponent" position="attributes">
            <attribute name="editLine.bind">onOpenProductPage</attribute>
        </xpath>
    </t>

    <t t-inherit="stock_barcode.LineDestinationLocation" t-inherit-mode="extension">
        <xpath expr="//div[@name='destination_location']" position="after">
            <div name="duplicate_button" class="mt-1">
                <!-- <button class="btn btn-sm btn-outline-secondary o_btn_duplicate_line py-0 px-2 fs-7"
