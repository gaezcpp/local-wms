<odoo>
    <record id="view_maintenance_business_area_tree" model="ir.ui.view">
        <field name="name">maintenance.business.area.tree</field>
        <field name="model">maintenance.business.area</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_maintenance_business_area_form" model="ir.ui.view">
        <field name="name">maintenance.business.area.form</field>
        <field name="model">maintenance.business.area</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_maintenance_business_area" model="ir.actions.act_window">
        <field name="name">Business Areas</field>
        <field name="res_model">maintenance.business.area</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_maintenance_business_area_root"
              name="Business Areas"
              parent="maintenance.menu_maintenance_config"
              action="action_maintenance_business_area"
              sequence="60"/>
</odoo>
