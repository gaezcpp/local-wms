<odoo>

    <record id="view_maintenance_equipment_form_inherit_adjustment" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.inherit.adjustment</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']/ancestor::group[1]" position="after">
                <group string="Tagging Structure" col="4" colspan="2">
                    <field name="equipment_no" readonly="1"/>
                    <field name="abc_indc"/>
                    <field name="system_id"/>
                    <field name="sub_system_id"/>
                    <field name="parent_equipment_id"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='technician_user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='technician_user_id']/ancestor::group[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='assign_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='assign_date']/ancestor::group[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='scrap_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='scrap_date']/ancestor::group[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Products">
                    <field name="product_line_ids" nolabel="1">
                        <list editable="bottom" create="0" edit="0" delete="0">
                            <field name="spare_part_id" domain="[('company_id','=',parent.company_id)]" readonly="1"/>
                            <field name="sku" readonly="1"/>
                            <field name="qty" readonly="1"/>
                            <field name="note" readonly="1"/>
                        </list>
                        <form>
                            <field name="equipment_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_maintenance_equipment_tree_inherit_adjustment" model="ir.ui.view">
        <field name="name">maintenance.equipment.tree.inherit.adjustment</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="equipment_no" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
