<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">

    <!-- =========================================================
         CRON: SAP Sync Equipment (Maintenance Equipment)
         ========================================================= -->
    <record id="ir_cron_tagging_sap_sync_equipment" model="ir.cron">
      <field name="name">SAP Sync Equipment</field>

      <!-- model_id harus menunjuk ke model tempat method cron ada
           Karena method ada di _inherit="maintenance.equipment",
           maka model_id-nya maintenance.equipment -->
      <field name="model_id" ref="maintenance.model_maintenance_equipment"/>

      <field name="state">code</field>
      <field name="code">model.cron_sync_equipment()</field>

      <field name="interval_number">1</field>
      <field name="interval_type">hours</field>

      <!-- optional: set jadwal pertama kali jalan -->
      <field name="nextcall">2026-02-13 08:00:00</field>

      <field name="active">True</field>
    </record>

  </data>
</odoo>
