<odoo>
    <record id="seq_maintenance_equipment_no" model="ir.sequence">
        <field name="name">Maintenance Equipment No</field>
        <field name="code">maintenance.equipment.no</field>
        <field name="prefix">EQ-%(year)s-</field>
        <field name="padding">5</field>
        <!-- set company_id to False for global sequence; set to a company for per-company sequence -->
        <field name="company_id" eval="False"/>
    </record>
</odoo>
